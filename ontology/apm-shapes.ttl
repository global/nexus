@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix apm:  <http://nexus-apm.org/ontology/apm#> .

###################################################################
# Nexus Insight APM — SHACL Integrity Constraints                 #
###################################################################
# This is a SHACL companion file that defines integrity constraints
# for validating instance data against the Nexus Insight APM ontology.

<http://nexus-apm.org/shapes> a owl:Ontology ;
    dct:title "Nexus Insight APM SHACL Shapes" ;
    dct:description "Integrity constraints validating instance data against the Nexus Insight APM ontology." ;
    owl:versionInfo "1.0.0" ;
    owl:imports <http://nexus-apm.org> .


### --------------------------------------------------
### Application
### --------------------------------------------------

apm:ApplicationShape a sh:NodeShape ;
    sh:targetClass apm:Application ;
    sh:property [
        sh:path apm:hasOwner ;
        sh:minCount 1 ;
        sh:message "Every Application must have at least one accountable owner." ;
    ] ;
    sh:property [
        sh:path apm:hasLifecycleStatus ;
        sh:maxCount 1 ;
        sh:message "An Application must not be classified with more than one Lifecycle Status at a time." ;
    ] ;
    sh:property [
        sh:path apm:hasCriticalityTier ;
        sh:maxCount 1 ;
        sh:message "An Application must not be classified with more than one Criticality Tier at a time." ;
    ] ;
    sh:property [
        sh:path apm:hasHostingModel ;
        sh:maxCount 1 ;
        sh:message "An Application must not be classified with more than one Hosting Model at a time." ;
    ] ;
    sh:property [
        sh:path apm:hasInvestmentStrategy ;
        sh:maxCount 1 ;
        sh:message "An Application must not be classified with more than one Investment Strategy at a time." ;
    ] .


### --------------------------------------------------
### Application Dependency
### --------------------------------------------------

apm:ApplicationDependencyShape a sh:NodeShape ;
    sh:targetClass apm:ApplicationDependency ;
    sh:property [
        sh:path apm:upstreamApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Dependency must name exactly one upstream Application." ;
    ] ;
    sh:property [
        sh:path apm:downstreamApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Dependency must name exactly one downstream Application." ;
    ] ;
    sh:property [
        sh:path apm:upstreamApplication ;
        sh:disjoint apm:downstreamApplication ;
        sh:message "An Application Dependency's upstream and downstream Application must be different." ;
    ] ;
    sh:property [
        sh:path apm:usesProtocol ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Dependency must specify exactly one Dependency Protocol." ;
    ] ;
    sh:property [
        sh:path apm:hasSynchronicity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Dependency must specify exactly one Synchronicity." ;
    ] .


### --------------------------------------------------
### Technology Dependency
### --------------------------------------------------

apm:TechnologyDependencyShape a sh:NodeShape ;
    sh:targetClass apm:TechnologyDependency ;
    sh:property [
        sh:path apm:upstreamTechnologyComponent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Technology Dependency must name exactly one upstream Physical Technology Component." ;
    ] ;
    sh:property [
        sh:path apm:downstreamTechnologyComponent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Technology Dependency must name exactly one downstream Physical Technology Component." ;
    ] ;
    sh:property [
        sh:path apm:upstreamTechnologyComponent ;
        sh:disjoint apm:downstreamTechnologyComponent ;
        sh:message "A Technology Dependency's upstream and downstream component must be different." ;
    ] ;
    sh:property [
        sh:path apm:usesProtocol ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Technology Dependency must specify exactly one Dependency Protocol." ;
    ] ;
    sh:property [
        sh:path apm:hasSynchronicity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Technology Dependency must specify exactly one Synchronicity." ;
    ] .


### --------------------------------------------------
### SLA Metric
### --------------------------------------------------

apm:SLAMetricShape a sh:NodeShape ;
    sh:targetClass apm:SLAMetric ;
    sh:property [
        sh:path apm:hasSLACategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every SLA Metric must be classified with exactly one SLA Category." ;
    ] ;
    sh:property [
        sh:path apm:targetValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every SLA Metric must record exactly one target value." ;
    ] ;
    sh:property [
        sh:path apm:unitOfMeasure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every SLA Metric must declare exactly one unit of measure." ;
    ] .


### --------------------------------------------------
### Service Level Agreement
### --------------------------------------------------

apm:ServiceLevelAgreementShape a sh:NodeShape ;
    sh:targetClass apm:ServiceLevelAgreement ;
    sh:property [
        sh:path apm:appliesToApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Service Level Agreement must apply to exactly one Application." ;
    ] ;
    sh:property [
        sh:path apm:effectiveFrom ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Service Level Agreement must record exactly one effective-from date." ;
    ] ;
    sh:property [
        sh:path apm:effectiveTo ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Service Level Agreement must record exactly one effective-to date." ;
    ] ;
    sh:property [
        sh:path apm:hasSLAMetric ;
        sh:minCount 1 ;
        sh:message "Every Service Level Agreement must have at least one SLA Metric." ;
    ] .


### --------------------------------------------------
### Application Contact
### --------------------------------------------------

apm:ApplicationContactShape a sh:NodeShape ;
    sh:targetClass apm:ApplicationContact ;
    sh:property [
        sh:path apm:forApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Contact must name exactly one Application." ;
    ] ;
    sh:property [
        sh:path apm:contactActor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Contact must name exactly one contact Actor." ;
    ] ;
    sh:property [
        sh:path apm:contactRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Application Contact must specify exactly one Role." ;
    ] .


### --------------------------------------------------
### Finding
### --------------------------------------------------

apm:FindingShape a sh:NodeShape ;
    sh:targetClass apm:Finding ;
    sh:property [
        sh:path apm:hasFindingCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Finding must be classified with exactly one Finding Category." ;
    ] ;
    sh:property [
        sh:path apm:hasFindingStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Finding must be classified with exactly one Finding Status." ;
    ] ;
    sh:property [
        sh:path apm:riskScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "riskScore must be a single integer between 1 and 5." ;
    ] ;
    sh:property [
        sh:path apm:likelihoodScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "likelihoodScore must be a single integer between 1 and 5." ;
    ] ;
    sh:property [
        sh:path apm:impactScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "impactScore must be a single integer between 1 and 5." ;
    ] ;
    sh:property [
        sh:path apm:cvssScore ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 10.0 ;
        sh:maxCount 1 ;
        sh:message "cvssScore must be a single decimal between 0.0 and 10.0." ;
    ] .

# Conditional rule: cvssScore may only be present on findings categorized
# as Vulnerability. 
apm:FindingCvssOnlyForVulnerabilityShape a sh:NodeShape ;
    sh:targetClass apm:Finding ;
    sh:or (
        [ sh:property [ sh:path apm:cvssScore ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path apm:hasFindingCategory ; sh:hasValue apm:Vulnerability ] ]
    ) ;
    sh:message "cvssScore may only be populated on a Finding categorized as Vulnerability." .


### --------------------------------------------------
### Cost Record
### --------------------------------------------------

apm:CostRecordShape a sh:NodeShape ;
    sh:targetClass apm:CostRecord ;
    sh:property [
        sh:path apm:incurredByApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Cost Record must name exactly one incurring Application." ;
    ] ;
    sh:property [
        sh:path apm:hasCostCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Cost Record must be classified with exactly one Cost Category." ;
    ] ;
    sh:property [
        sh:path apm:costAmount ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Cost Record must record exactly one cost amount." ;
    ] ;
    sh:property [
        sh:path apm:costCurrency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Cost Record must declare exactly one currency." ;
    ] ;
    sh:property [
        sh:path apm:fiscalYear ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Cost Record must be attributed to exactly one fiscal year." ;
    ] .


### --------------------------------------------------
### Business Capability
### --------------------------------------------------

apm:BusinessCapabilityShape a sh:NodeShape ;
    sh:targetClass apm:BusinessCapability ;
    sh:property [
        sh:path apm:capabilityWeight ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "capabilityWeight must be a single integer between 1 and 5." ;
    ] .


### --------------------------------------------------
### Performance Assessment
### --------------------------------------------------

apm:PerformanceAssessmentShape a sh:NodeShape ;
    sh:targetClass apm:PerformanceAssessment ;
    sh:property [
        sh:path apm:assessesApplication ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Performance Assessment must evaluate exactly one Application." ;
    ] ;
    sh:property [
        sh:path apm:businessFitScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "businessFitScore must be a single integer between 1 and 5." ;
    ] ;
    sh:property [
        sh:path apm:technicalFitScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:maxCount 1 ;
        sh:message "technicalFitScore must be a single integer between 1 and 5." ;
    ] ;
    sh:property [
        sh:path apm:assessedOn ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Performance Assessment must record exactly one assessment date." ;
    ] .


### --------------------------------------------------
### Portfolio
### --------------------------------------------------

apm:PortfolioShape a sh:NodeShape ;
    sh:targetClass apm:Portfolio ;
    sh:property [
        sh:path apm:containsApplication ;
        sh:minCount 1 ;
        sh:message "Every Portfolio must contain at least one Application." ;
    ] ;
    sh:property [
        sh:path apm:portfolioOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Portfolio must have exactly one accountable owner." ;
    ] ;
    sh:property [
        sh:path apm:alignsToCapability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Portfolio must align to exactly one Business Capability." ;
    ] .


### --------------------------------------------------
### Software Entitlement
### --------------------------------------------------

apm:SoftwareEntitlementShape a sh:NodeShape ;
    sh:targetClass apm:SoftwareEntitlement ;
    sh:property [
        sh:path apm:entitledQuantity ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Software Entitlement must record exactly one entitled quantity." ;
    ] ;
    sh:property [
        sh:path apm:measuredByMetric ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Software Entitlement must be assessed by exactly one Metric." ;
    ] .


### --------------------------------------------------
### Resource Utilization Record
### --------------------------------------------------

apm:ResourceUtilizationRecordShape a sh:NodeShape ;
    sh:targetClass apm:ResourceUtilizationRecord ;
    sh:property [
        sh:path apm:measuresProduct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Resource Utilization Record must measure exactly one Software Product." ;
    ] ;
    sh:property [
        sh:path apm:measuredAgainstMetric ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Resource Utilization Record must be expressed against exactly one Metric." ;
    ] ;
    sh:property [
        sh:path apm:measuredValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Resource Utilization Record must record exactly one measured value." ;
    ] ;
    sh:property [
        sh:path apm:measurementPeriodStart ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Resource Utilization Record must record exactly one measurement period start date." ;
    ] ;
    sh:property [
        sh:path apm:measurementPeriodEnd ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every Resource Utilization Record must record exactly one measurement period end date." ;
    ] .
