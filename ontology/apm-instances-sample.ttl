### Data Entities
### --------------------------------------------------

apm:EmployeeRecord a apm:DataEntity ;
    rdfs:label "Employee Record" ;
    apm:hasDataSensitivity apm:PII .

apm:PayrollRecord a apm:DataEntity ;
    rdfs:label "Payroll Record" ;
    apm:hasDataSensitivity apm:PII, apm:Confidential .

apm:CustomerSubscriptionRecord a apm:DataEntity ;
    rdfs:label "Customer Subscription Record" ;
    apm:hasDataSensitivity apm:PII .

apm:PaymentCardData a apm:DataEntity ;
    rdfs:label "Payment Card Data" ;
    apm:hasDataSensitivity apm:PII, apm:HighlyConfidential .


### --------------------------------------------------
### Applications
### --------------------------------------------------

apm:PeopleHubHRIS a apm:Application ;
    rdfs:label "PeopleHub HRIS" ;
    apm:hasOwner apm:VirginiaWoolf ;
    apm:managedByOrganizationUnit apm:HRDepartment ;
    apm:enablesCapability apm:TalentAcquisition, apm:PayrollBenefits ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:High ;
    apm:hasHostingModel apm:ExternallyHosted ;
    apm:hostedBySupplier apm:WorkforceCloudInc ;
    apm:hasInvestmentStrategy apm:Invest ;
    apm:requiresCompliance apm:GDPR, apm:SOC2 ;
    apm:goLiveDate "2021-03-01"^^xsd:date ;
    apm:recoveryTimeObjective "PT8H"^^xsd:duration ;
    apm:recoveryPointObjective "PT4H"^^xsd:duration ;
    apm:accessesData apm:EmployeeRecord .

apm:PayStreamPayroll a apm:Application ;
    rdfs:label "PayStream Payroll" ;
    apm:hasOwner apm:VirginiaWoolf ;
    apm:managedByOrganizationUnit apm:HRDepartment ;
    apm:enablesCapability apm:PayrollBenefits ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:Critical ;
    apm:hasHostingModel apm:ExternallyHosted ;
    apm:hostedBySupplier apm:PayStreamVendor ;
    apm:hasInvestmentStrategy apm:Tolerate ;
    apm:requiresCompliance apm:SOC2, apm:ISO27001 ;
    apm:goLiveDate "2019-09-15"^^xsd:date ;
    apm:recoveryTimeObjective "PT4H"^^xsd:duration ;
    apm:recoveryPointObjective "PT1H"^^xsd:duration ;
    apm:accessesData apm:EmployeeRecord, apm:PayrollRecord .

apm:ProcureSuite a apm:Application ;
    rdfs:label "ProcureSuite" ;
    apm:hasOwner apm:ThomasHardy ;
    apm:managedByOrganizationUnit apm:ProcurementDepartment ;
    apm:enablesCapability apm:VendorToolingManagement, apm:PurchaseOrderManagement ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:Medium ;
    apm:hasHostingModel apm:ExternallyHosted ;
    apm:hostedBySupplier apm:ProcureSuiteVendor ;
    apm:hasInvestmentStrategy apm:Tolerate ;
    apm:requiresCompliance apm:SOC2 ;
    apm:goLiveDate "2020-01-10"^^xsd:date .
    # Used company-wide, including to procure the cloud/SaaS tooling that
    # Engineering and IT depend on.

apm:BuildForgePlatform a apm:Application ;
    rdfs:label "BuildForge CI/CD Platform" ;
    apm:hasOwner apm:EmilyBronte ;
    apm:managedByOrganizationUnit apm:EngineeringDepartment ;
    apm:enablesCapability apm:SoftwareEngineering, apm:DevOpsReleaseManagement ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:Critical ;
    apm:hasHostingModel apm:InternallyHosted ;
    apm:hasInvestmentStrategy apm:Migrate ;
    apm:goLiveDate "2013-04-01"^^xsd:date ;
    apm:recoveryTimeObjective "PT24H"^^xsd:duration ;
    apm:recoveryPointObjective "PT12H"^^xsd:duration ;
    apm:comprisesLogicalComponent apm:BuildForgePlatform_LogicalComponent ;
    apm:hasDeployment apm:BuildForgePlatform_Instance .
    # NOTE: a 24h/12h RTO/RPO on a Critical-tier application is a deliberate
    # inconsistency for CQ-11 to surface -- every engineer's ability to
    # build and ship software runs through this platform, yet its recovery
    # posture has not kept pace with that criticality. The self-hosted
    # on-premises CI/CD orchestrator every build and release passes
    # through: over a decade old, unsupported since 2023, and the single
    # highest-cost, hardest-to-replace system in the portfolio.

apm:DeployTrackReleaseManager a apm:Application ;
    rdfs:label "DeployTrack Release Manager" ;
    apm:hasOwner apm:EmilyBronte ;
    apm:managedByOrganizationUnit apm:EngineeringDepartment ;
    apm:enablesCapability apm:DevOpsReleaseManagement, apm:QualityAssuranceTesting ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:High ;
    apm:hasHostingModel apm:InternallyHosted ;
    apm:hasInvestmentStrategy apm:Tolerate ;
    apm:goLiveDate "2017-04-01"^^xsd:date ;
    apm:recoveryTimeObjective "PT6H"^^xsd:duration ;
    apm:recoveryPointObjective "PT2H"^^xsd:duration ;
    apm:comprisesLogicalComponent apm:DeployTrackReleaseManager_LogicalComponent ;
    apm:hasDeployment apm:DeployTrackReleaseManager_Instance .
    # Tracks deployment artifacts, environments, and release approvals
    # across the engineering organisation's staging and production
    # pipelines; pulls build artifacts from BuildForge.

apm:SecureAuthIAM a apm:Application ;
    rdfs:label "SecureAuth IAM" ;
    apm:hasOwner apm:GeorgeOrwell ;
    apm:managedByOrganizationUnit apm:ITDepartment ;
    apm:enablesCapability apm:IdentityAccessManagement, apm:CybersecurityOperations ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:Critical ;
    apm:hasHostingModel apm:InternallyHosted ;
    apm:hasInvestmentStrategy apm:Invest ;
    apm:requiresCompliance apm:ISO27001, apm:SOC2 ;
    apm:goLiveDate "2022-11-01"^^xsd:date ;
    apm:recoveryTimeObjective "PT1H"^^xsd:duration ;
    apm:recoveryPointObjective "PT15M"^^xsd:duration ;
    apm:implementsControl apm:MFAControl ;
    apm:hasDocument apm:Doc_IAM_ThreatModel .

apm:CustomerPortalWeb a apm:Application ;
    rdfs:label "Customer Portal (Web)" ;
    apm:hasOwner apm:DHLawrence ;
    apm:managedByOrganizationUnit apm:SalesDepartment ;
    apm:enablesCapability apm:SubscriptionBillingManagement, apm:CustomerRelationshipManagement ;
