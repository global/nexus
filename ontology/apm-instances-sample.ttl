### --------------------------------------------------
### Performance Assessments (Business Fit / Technical Fit)
### --------------------------------------------------

apm:PA_BuildForge_2025 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:BuildForgePlatform ; apm:assessedBy apm:JaneAusten ;
    apm:businessFitScore 5 ; apm:technicalFitScore 2 ; apm:assessedOn "2025-03-01"^^xsd:date .
apm:PA_BuildForge_2026 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:BuildForgePlatform ; apm:assessedBy apm:JaneAusten ;
    apm:businessFitScore 5 ; apm:technicalFitScore 2 ; apm:assessedOn "2026-03-01"^^xsd:date .
    # High, stable business value (nobody can ship without it) with
    # persistently low technical fit -- the evidentiary basis for
    # BuildForge's Migrate classification.

apm:PA_HRIS_2025 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:PeopleHubHRIS ; apm:assessedBy apm:JaneAusten ;
    apm:businessFitScore 4 ; apm:technicalFitScore 4 ; apm:assessedOn "2025-03-01"^^xsd:date .
apm:PA_HRIS_2026 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:PeopleHubHRIS ; apm:assessedBy apm:JaneAusten ;
    apm:businessFitScore 4 ; apm:technicalFitScore 5 ; apm:assessedOn "2026-03-01"^^xsd:date .
    # Technical fit trending upward -- supports the Invest classification.

apm:PA_ProcureSuite_2026 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:ProcureSuite ; apm:assessedBy apm:JaneAusten ;
    apm:businessFitScore 2 ; apm:technicalFitScore 4 ; apm:assessedOn "2026-03-01"^^xsd:date .

apm:PA_FinReport_2026 a apm:PerformanceAssessment ;
    apm:assessesApplication apm:FinReportLegacy ; apm:assessedBy apm:WilliamWordsworth ;
    apm:businessFitScore 1 ; apm:technicalFitScore 1 ; apm:assessedOn "2026-03-01"^^xsd:date .


### --------------------------------------------------
### Service Level Agreements
### --------------------------------------------------

apm:SLA_HRIS_2026 a apm:ServiceLevelAgreement ;
    apm:appliesToApplication apm:PeopleHubHRIS ;
    apm:effectiveFrom "2026-01-01"^^xsd:date ; apm:effectiveTo "2026-12-31"^^xsd:date ;
    apm:hasSLAMetric apm:SLA_HRIS_Availability, apm:SLA_HRIS_ResponseTime .
apm:SLA_HRIS_Availability a apm:SLAMetric ;
    apm:hasSLACategory apm:Availability ; apm:targetValue 99.9 ; apm:unitOfMeasure "%" .
apm:SLA_HRIS_ResponseTime a apm:SLAMetric ;
    apm:hasSLACategory apm:ResponseTime ; apm:targetValue 500 ; apm:unitOfMeasure "milliseconds" .

apm:SLA_CustomerPortal_2026 a apm:ServiceLevelAgreement ;
    apm:appliesToApplication apm:CustomerPortalWeb ;
    apm:effectiveFrom "2026-01-01"^^xsd:date ; apm:effectiveTo "2026-12-31"^^xsd:date ;
    apm:hasSLAMetric apm:SLA_CustomerPortal_Availability, apm:SLA_CustomerPortal_Throughput .
apm:SLA_CustomerPortal_Availability a apm:SLAMetric ;
    apm:hasSLACategory apm:Availability ; apm:targetValue 99.95 ; apm:unitOfMeasure "%" .
apm:SLA_CustomerPortal_Throughput a apm:SLAMetric ;
    apm:hasSLACategory apm:Throughput ; apm:targetValue 1200 ; apm:unitOfMeasure "requests/second" .


