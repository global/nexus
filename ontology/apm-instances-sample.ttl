apm:CloudHostSupplier a apm:Supplier ;
    rdfs:label "NimbusCloud Hosting" ;
    apm:hasCertification apm:SOC2, apm:ISO27001, apm:PCIDSS .

apm:CRMVendorInc a apm:Supplier ;
    rdfs:label "SummitCRM Inc." ;
