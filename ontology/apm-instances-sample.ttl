@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix apm:  <http://nexus-apm.org/ontology/apm#> .

###################################################################
# Nexus Insight APM — Sample Instance Data                        #
# Scenario: "NexusAPM" — a fictional, medium-size enterprise      #
# SaaS company (~650 employees) that builds and sells             #
# workflow-automation and data-integration software for other     #
# businesses. Used to exercise the ontology defined in            #
# apm-ontology.ttl and validate it against the competency         #
# questions in apm-competency-queries.sparql.                     #
###################################################################
#
# This file is deliberately kept separate from the ontology
# definition, consistent with the separation already established
# between apm-ontology.ttl and apm-shapes.ttl: this file supplies
# instance data; apm-ontology.ttl supplies the vocabulary
# those instances use; apm-shapes.ttl supplies the constraints this
# data is expected to satisfy.
#
# SCENARIO GUIDE — the following situations are deliberately built
# into the data so that each competency question returns a
# meaningful, non-trivial result:
#
#   * A cascading outage scenario: apm:SecureAuthIAM (Identity &
#     Access Management) is a dependency of four other applications,
#     one of which (apm:PayStreamPayroll) is itself downstream of a
#     fifth -- so an IAM outage traces through two hops of blast
#     radius. Separately, apm:BuildFarmServer is a technology
#     dependency of apm:DeployTrackAppServer, giving a concrete
#     "infrastructure outage -> business capability" trace (CQ-1).
#   * A legacy, unsupported on-premises CI/CD platform
#     (apm:BuildForgePlatform): past its end-of-support date,
#     classified Migrate, high and rising maintenance cost, weak
#     recovery objectives despite Critical criticality -- the
#     classic "we can't ship software without it, but nobody wants
#     to touch it" legacy engineering system (CQ-8, CQ-10, CQ-11).
#   * A vendor compliance gap: apm:PayStreamPayroll requires ISO/IEC
#     27001, but its hosting supplier (apm:PayStreamVendor) is only
#     certified to SOC 2 (CQ-4, CQ-5).
#   * An overdue, high-severity vulnerability on the customer-facing
#     apm:CustomerPortalWeb (CQ-7), alongside a Remediated example
#     and a RiskAccepted example, to show the full status lifecycle.
#   * A full TIME quadrant spread across the portfolio: Invest
#     (apm:PeopleHubHRIS), Tolerate (apm:ProcureSuite), Migrate
#     (apm:BuildForgePlatform), Eliminate (apm:FinReportLegacy) (CQ-8).
#   * A software-entitlement-vs-usage comparison for apm:PeopleHubHRIS
#     (CQ-12).
#   * A three-level business capability hierarchy under Information
#     Technology, used to demonstrate impact roll-up (CQ-13).
#
# All monetary values are illustrative, in EUR. All dates are
# consistent with a "today" of 2026-07-19.


### --------------------------------------------------
### Locations
### --------------------------------------------------

apm:NexusAPMHQ a apm:Location ;
    rdfs:label "NexusAPM HQ, Dublin, Ireland" .

apm:EngineeringHubToronto a apm:Location ;
    rdfs:label "Engineering Hub, Toronto, ON" .


### --------------------------------------------------
### Organization Units
### --------------------------------------------------

apm:HRDepartment a apm:OrganizationUnit ;
    rdfs:label "Human Resources" ;
    apm:costCenterCode "CC-100" ;
    apm:locatedAt apm:NexusAPMHQ .

apm:ProcurementDepartment a apm:OrganizationUnit ;
    rdfs:label "Procurement" ;
    apm:costCenterCode "CC-200" ;
    apm:locatedAt apm:NexusAPMHQ .

apm:ITDepartment a apm:OrganizationUnit ;
    rdfs:label "Information Technology" ;
    apm:costCenterCode "CC-300" ;
    apm:locatedAt apm:NexusAPMHQ .

apm:EngineeringDepartment a apm:OrganizationUnit ;
    rdfs:label "Engineering" ;
    apm:costCenterCode "CC-400" ;
    apm:locatedAt apm:EngineeringHubToronto .

apm:FinanceDepartment a apm:OrganizationUnit ;
    rdfs:label "Finance" ;
    apm:costCenterCode "CC-500" ;
    apm:locatedAt apm:NexusAPMHQ .

apm:SalesDepartment a apm:OrganizationUnit ;
    rdfs:label "Sales & Customer Management" ;
    apm:costCenterCode "CC-600" ;
    apm:locatedAt apm:NexusAPMHQ .


