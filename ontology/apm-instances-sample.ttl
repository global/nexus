    apm:hasCriticalityTier apm:Critical ;
    apm:hasHostingModel apm:ExternallyHosted ;
    apm:hostedBySupplier apm:CloudHostSupplier ;
    apm:hasInvestmentStrategy apm:Invest ;
    apm:requiresCompliance apm:PCIDSS ;
    apm:goLiveDate "2023-02-15"^^xsd:date ;
    apm:recoveryTimeObjective "PT2H"^^xsd:duration ;
    apm:recoveryPointObjective "PT30M"^^xsd:duration ;
    apm:accessesData apm:CustomerSubscriptionRecord, apm:PaymentCardData ;
    apm:hasRepository apm:Repo_CustomerPortal_Web .
    # The self-service portal where NexusAPM's customers manage their
    # subscription, view product usage, and update billing details.

apm:CRMPlatform a apm:Application ;
    rdfs:label "Summit CRM" ;
    apm:hasOwner apm:DHLawrence ;
    apm:managedByOrganizationUnit apm:SalesDepartment ;
    apm:enablesCapability apm:CustomerRelationshipManagement ;
