### --------------------------------------------------
### Business Capability Map (three-level hierarchy)
### --------------------------------------------------

apm:HumanResourceManagement a apm:BusinessCapability ;
    rdfs:label "Human Resource Management" ; apm:capabilityWeight 4 .
apm:TalentAcquisition a apm:BusinessCapability ;
    rdfs:label "Talent Acquisition" ; apm:capabilityWeight 3 ;
    apm:subCapabilityOf apm:HumanResourceManagement .
apm:PayrollBenefits a apm:BusinessCapability ;
    rdfs:label "Payroll & Benefits" ; apm:capabilityWeight 5 ;
    apm:subCapabilityOf apm:HumanResourceManagement .

apm:Procurement a apm:BusinessCapability ;
    rdfs:label "Procurement" ; apm:capabilityWeight 3 .
apm:VendorToolingManagement a apm:BusinessCapability ;
    rdfs:label "Vendor & Tooling Management" ; apm:capabilityWeight 3 ;
    apm:subCapabilityOf apm:Procurement .
apm:PurchaseOrderManagement a apm:BusinessCapability ;
    rdfs:label "Purchase Order Management" ; apm:capabilityWeight 3 ;
    apm:subCapabilityOf apm:Procurement .

apm:InformationTechnology a apm:BusinessCapability ;
    rdfs:label "Information Technology" ; apm:capabilityWeight 5 .
apm:ITServiceManagement a apm:BusinessCapability ;
    rdfs:label "IT Service Management" ; apm:capabilityWeight 4 ;
    apm:subCapabilityOf apm:InformationTechnology .
apm:CybersecurityOperations a apm:BusinessCapability ;
    rdfs:label "Cybersecurity Operations" ; apm:capabilityWeight 5 ;
    apm:subCapabilityOf apm:InformationTechnology .
apm:IdentityAccessManagement a apm:BusinessCapability ;
    rdfs:label "Identity & Access Management" ; apm:capabilityWeight 5 ;
    apm:subCapabilityOf apm:CybersecurityOperations .

apm:EngineeringProductDelivery a apm:BusinessCapability ;
    rdfs:label "Engineering & Product Delivery" ; apm:capabilityWeight 5 .
apm:SoftwareEngineering a apm:BusinessCapability ;
    rdfs:label "Software Engineering" ; apm:capabilityWeight 5 ;
    apm:subCapabilityOf apm:EngineeringProductDelivery .
apm:DevOpsReleaseManagement a apm:BusinessCapability ;
    rdfs:label "DevOps & Release Management" ; apm:capabilityWeight 4 ;
    apm:subCapabilityOf apm:EngineeringProductDelivery .
apm:QualityAssuranceTesting a apm:BusinessCapability ;
    rdfs:label "Quality Assurance & Testing" ; apm:capabilityWeight 4 ;
    apm:subCapabilityOf apm:EngineeringProductDelivery .

apm:Finance a apm:BusinessCapability ;
    rdfs:label "Finance" ; apm:capabilityWeight 4 .
apm:FinancialReporting a apm:BusinessCapability ;
    rdfs:label "Financial Reporting" ; apm:capabilityWeight 4 ;
    apm:subCapabilityOf apm:Finance .
apm:AccountsPayableReceivable a apm:BusinessCapability ;
    rdfs:label "Accounts Payable / Receivable" ; apm:capabilityWeight 3 ;
    apm:subCapabilityOf apm:Finance .
    # NOTE: deliberately left without a linked Application -- a realistic
    # "capability with no dedicated system of record yet" gap.

apm:SalesCustomerManagement a apm:BusinessCapability ;
    rdfs:label "Sales & Customer Management" ; apm:capabilityWeight 5 .
apm:CustomerRelationshipManagement a apm:BusinessCapability ;
    rdfs:label "Customer Relationship Management" ; apm:capabilityWeight 4 ;
    apm:subCapabilityOf apm:SalesCustomerManagement .
apm:SubscriptionBillingManagement a apm:BusinessCapability ;
    rdfs:label "Subscription & Billing Management" ; apm:capabilityWeight 5 ;
    apm:subCapabilityOf apm:SalesCustomerManagement .


