### --------------------------------------------------
### Controls
### --------------------------------------------------

apm:MFAControl a apm:Control ;
    rdfs:label "Multi-Factor Authentication" ;
    apm:controlReference "ISO/IEC 27002:2022 5.17" ;
    apm:supportsComplianceStandard apm:ISO27001 .

apm:AccessReviewControl a apm:Control ;
    rdfs:label "Periodic Access Review" ;
    apm:controlReference "ISO/IEC 27002:2022 5.18" ;
    apm:supportsComplianceStandard apm:ISO27001, apm:SOC2 .


