### --------------------------------------------------
### Logical / Physical Application Components and
### Physical Technology Components
### --------------------------------------------------

apm:BuildForgePlatform_LogicalComponent a apm:LogicalApplicationComponent ;
    rdfs:label "BuildForge Core Logical Component" .

apm:DeployTrackReleaseManager_LogicalComponent a apm:LogicalApplicationComponent ;
    rdfs:label "DeployTrack Core Logical Component" .

apm:BuildFarmServer a apm:PhysicalTechnologyComponent ;
    rdfs:label "Build Farm Server" ;
    apm:assetIdentifier "build-farm-prod-01.nexusapm.example" ;
    apm:hasEnvironment apm:Production .

apm:DeployTrackAppServer a apm:PhysicalTechnologyComponent ;
    rdfs:label "DeployTrack Application Server" ;
    apm:assetIdentifier "app-deploytrack-prod-01.nexusapm.example" ;
    apm:hasEnvironment apm:Production .

apm:BuildForgePlatform_Instance a apm:PhysicalApplicationComponent ;
    rdfs:label "BuildForge CI/CD Platform — Production Instance" ;
    apm:realizesLogicalComponent apm:BuildForgePlatform_LogicalComponent ;
    apm:deployedOn apm:BuildFarmServer ;
    apm:hasEnvironment apm:Production ;
    apm:identifiedBy apm:BuildForgePlatform_SoftwareProduct .

apm:DeployTrackReleaseManager_Instance a apm:PhysicalApplicationComponent ;
    rdfs:label "DeployTrack Release Manager — Production Instance" ;
    apm:realizesLogicalComponent apm:DeployTrackReleaseManager_LogicalComponent ;
    apm:deployedOn apm:DeployTrackAppServer ;
    apm:hasEnvironment apm:Production .

# Technology-layer dependency: the DeployTrack application server relies on
# the build farm server for build artifacts and status in real time. This
# is the concrete "infrastructure outage -> business capability" scenario
# used in CQ-1.
apm:TechDep_DeployTrackServer_on_BuildFarmServer a apm:TechnologyDependency ;
    apm:upstreamTechnologyComponent apm:BuildFarmServer ;
    apm:downstreamTechnologyComponent apm:DeployTrackAppServer ;
    apm:usesProtocol apm:DatabaseConnection ;
    apm:hasSynchronicity apm:Synchronous .


### --------------------------------------------------
### Software Products, Entitlements, Metrics, and
### Resource Utilization (ISO/IEC 19770-2/-3/-4)
### --------------------------------------------------

apm:BuildForgePlatform_SoftwareProduct a apm:SoftwareProduct ;
    rdfs:label "BuildForge Enterprise" ;
    apm:version "5.4" ;
    apm:endOfLifeDate "2022-06-30"^^xsd:date ;
    apm:endOfSupportDate "2023-12-31"^^xsd:date .
    # NOTE: over two and a half years past end-of-support as of 2026-07-19 --
    # the primary example for CQ-10.

apm:FinReportLegacy_SoftwareProduct a apm:SoftwareProduct ;
    rdfs:label "FinReport Classic" ;
    apm:version "3.1" ;
    apm:endOfLifeDate "2017-06-01"^^xsd:date ;
    apm:endOfSupportDate "2019-01-01"^^xsd:date .

apm:FinReportLegacy_Instance a apm:PhysicalApplicationComponent ;
    rdfs:label "FinReport Legacy — Production Instance" ;
    apm:hasEnvironment apm:Production ;
    apm:identifiedBy apm:FinReportLegacy_SoftwareProduct .
    # Linked so that CQ-10 (end-of-life/end-of-support exposure) surfaces
    # both BuildForge and FinReport Legacy as affected applications.

apm:PeopleHubHRIS_SoftwareProduct a apm:SoftwareProduct ;
    rdfs:label "PeopleHub HRIS" ;
    apm:version "24.3" ;
    apm:suppliedBy apm:WorkforceCloudInc ;
    apm:coveredByEntitlement apm:PeopleHubHRIS_Entitlement .

apm:PerNamedUserMetric a apm:Metric ;
    rdfs:label "Per Named User" .

apm:PeopleHubHRIS_Entitlement a apm:SoftwareEntitlement ;
    rdfs:label "PeopleHub HRIS — 500 Named-User Licenses" ;
    apm:measuredByMetric apm:PerNamedUserMetric ;
    apm:entitledQuantity 500 .

apm:PeopleHubHRIS_Usage_H1_2026 a apm:ResourceUtilizationRecord ;
    apm:measuresProduct apm:PeopleHubHRIS_SoftwareProduct ;
    apm:measuredAgainstMetric apm:PerNamedUserMetric ;
    apm:measuredValue 340 ;
    apm:measurementPeriodStart "2026-01-01"^^xsd:date ;
    apm:measurementPeriodEnd "2026-06-30"^^xsd:date .
    # 340 of 500 entitled named-user seats actually used in H1 2026 -- a
    # 68% utilisation rate, the basis for CQ-12.


### --------------------------------------------------
### Application Dependencies
### --------------------------------------------------
# SecureAuth IAM is a shared dependency of four applications, one of which
# (PayStream Payroll) is itself downstream of PeopleHub HRIS, and another
# of which (Customer Portal (Web)) is itself upstream of Summit CRM --
# giving a two-hop transitive blast radius from a single IAM outage in
# both directions, used in CQ-2.

apm:Dep_HRIS_on_IAM a apm:ApplicationDependency ;
    apm:upstreamApplication apm:SecureAuthIAM ;
    apm:downstreamApplication apm:PeopleHubHRIS ;
    apm:usesProtocol apm:RESTAPI ;
    apm:hasSynchronicity apm:Synchronous .

apm:Dep_ProcureSuite_on_IAM a apm:ApplicationDependency ;
    apm:upstreamApplication apm:SecureAuthIAM ;
    apm:downstreamApplication apm:ProcureSuite ;
    apm:usesProtocol apm:RESTAPI ;
    apm:hasSynchronicity apm:Synchronous .

apm:Dep_CustomerPortal_on_IAM a apm:ApplicationDependency ;
    apm:upstreamApplication apm:SecureAuthIAM ;
    apm:downstreamApplication apm:CustomerPortalWeb ;
    apm:usesProtocol apm:RESTAPI ;
    apm:hasSynchronicity apm:Synchronous .

apm:Dep_ITServiceHub_on_IAM a apm:ApplicationDependency ;
    apm:upstreamApplication apm:SecureAuthIAM ;
    apm:downstreamApplication apm:ITServiceHub ;
    apm:usesProtocol apm:RESTAPI ;
    apm:hasSynchronicity apm:Synchronous .

apm:Dep_PayStream_on_HRIS a apm:ApplicationDependency ;
    apm:upstreamApplication apm:PeopleHubHRIS ;
    apm:downstreamApplication apm:PayStreamPayroll ;
    apm:usesProtocol apm:RESTAPI ;
    apm:hasSynchronicity apm:Batch .

apm:Dep_DeployTrack_on_BuildForge a apm:ApplicationDependency ;
    apm:upstreamApplication apm:BuildForgePlatform ;
    apm:downstreamApplication apm:DeployTrackReleaseManager ;
    apm:usesProtocol apm:DatabaseConnection ;
    apm:hasSynchronicity apm:Synchronous .

apm:Dep_CRM_on_CustomerPortal a apm:ApplicationDependency ;
    apm:upstreamApplication apm:CustomerPortalWeb ;
    apm:downstreamApplication apm:CRMPlatform ;
    apm:usesProtocol apm:MessageQueue ;
    apm:hasSynchronicity apm:Asynchronous .


### --------------------------------------------------
### Findings
### --------------------------------------------------

apm:Finding_CVE_CustomerPortal a apm:Finding ;
    apm:affectsApplication apm:CustomerPortalWeb ;
    apm:hasFindingCategory apm:Vulnerability ;
    apm:cveId "CVE-2026-13371" ;
    apm:cvssScore 9.1 ;
    apm:findingDetails "Unauthenticated remote code execution in the customer portal's payment integration library." ;
    apm:likelihoodScore 5 ;
    apm:impactScore 5 ;
    apm:riskScore 5 ;
    apm:hasImpactType apm:DataBreach, apm:RegulatoryFine, apm:ReputationalDamage ;
    apm:identifiedOn "2026-05-01"^^xsd:date ;
    apm:dueDate "2026-05-31"^^xsd:date ;
    apm:hasFindingStatus apm:Open .
    # Overdue by roughly seven weeks as of 2026-07-19 -- the primary
    # example for CQ-7.

apm:Finding_EOL_BuildForge a apm:Finding ;
    apm:affectsApplication apm:BuildForgePlatform ;
    apm:hasFindingCategory apm:TechnicalRisk ;
    apm:findingDetails "BuildForge Enterprise 5.4 has been unsupported by the vendor since 2023-12-31; no further security patches are available for the CI/CD platform underpinning every software release." ;
    apm:likelihoodScore 3 ;
    apm:impactScore 5 ;
    apm:riskScore 4 ;
    apm:hasImpactType apm:ServiceOutage, apm:FinancialLoss ;
    apm:identifiedOn "2026-01-15"^^xsd:date ;
    apm:dueDate "2026-09-30"^^xsd:date ;
    apm:hasFindingStatus apm:Open .

apm:Finding_ControlGap_PayStream a apm:Finding ;
    apm:affectsApplication apm:PayStreamPayroll ;
    apm:hasFindingCategory apm:ControlGap ;
    apm:relatesToControl apm:MFAControl ;
    apm:findingDetails "PayStream Payroll administrative console does not enforce multi-factor authentication." ;
    apm:likelihoodScore 3 ;
    apm:impactScore 4 ;
    apm:riskScore 4 ;
    apm:hasImpactType apm:DataBreach ;
    apm:identifiedOn "2026-06-01"^^xsd:date ;
    apm:dueDate "2026-08-15"^^xsd:date ;
    apm:hasFindingStatus apm:InRemediation .

apm:Finding_BusinessRisk_IAM a apm:Finding ;
    apm:affectsApplication apm:SecureAuthIAM ;
    apm:hasFindingCategory apm:BusinessRisk ;
    apm:threatensCapability apm:IdentityAccessManagement ;
    apm:findingDetails "SecureAuth IAM has no active-active failover; a regional outage would remove authentication for four downstream applications simultaneously." ;
    apm:likelihoodScore 2 ;
    apm:impactScore 5 ;
    apm:riskScore 4 ;
    apm:hasImpactType apm:ServiceOutage, apm:FinancialLoss ;
    apm:identifiedOn "2026-04-10"^^xsd:date ;
    apm:dueDate "2026-07-10"^^xsd:date ;
    apm:hasFindingStatus apm:Open .
    # Overdue by roughly nine days as of 2026-07-19; demonstrates CQ-13
    # (impact rolls up from Identity & Access Management to Cybersecurity
    # Operations to Information Technology).

apm:Finding_TechRisk_FinReport a apm:Finding ;
    apm:affectsApplication apm:FinReportLegacy ;
    apm:hasFindingCategory apm:TechnicalRisk ;
    apm:findingDetails "FinReport Classic 3.1 has been unsupported since 2019; the application is scheduled for retirement and the residual risk has been formally accepted." ;
    apm:likelihoodScore 2 ;
    apm:impactScore 2 ;
    apm:riskScore 2 ;
    apm:identifiedOn "2025-11-01"^^xsd:date ;
    apm:dueDate "2026-02-01"^^xsd:date ;
    apm:hasFindingStatus apm:RiskAccepted .
    # Past due but formally risk-accepted -- shows that "overdue" (CQ-7)
    # must be filtered by status, not date alone.

apm:Finding_Vuln_BuildFarmServer_Remediated a apm:Finding ;
    apm:affectsTechnologyComponent apm:BuildFarmServer ;
    apm:hasFindingCategory apm:Vulnerability ;
    apm:cveId "CVE-2025-44120" ;
    apm:cvssScore 7.5 ;
    apm:findingDetails "Unpatched OpenSSL vulnerability on the build farm server, resolved during the March 2026 patch cycle." ;
    apm:likelihoodScore 3 ;
    apm:impactScore 4 ;
    apm:riskScore 3 ;
    apm:hasImpactType apm:ServiceOutage ;
    apm:identifiedOn "2026-02-01"^^xsd:date ;
    apm:dueDate "2026-03-01"^^xsd:date ;
    apm:hasFindingStatus apm:Remediated .


