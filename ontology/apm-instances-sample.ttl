    apm:enablesCapability apm:FinancialReporting ;
    apm:hasLifecycleStatus apm:Operate ;
    apm:hasCriticalityTier apm:Low ;
    apm:hasHostingModel apm:InternallyHosted ;
    apm:hasInvestmentStrategy apm:Eliminate ;
    apm:goLiveDate "2008-01-01"^^xsd:date ;
