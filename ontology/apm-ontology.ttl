@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix apm: <http://nexus-apm.org/ontology/apm#> .


###################################################################
# Nexus Insight — Application Portfolio Management (APM) Ontology #
###################################################################

<http://nexus-apm.org> a owl:Ontology ;
    rdfs:comment "A unified ontology for Application Portfolio Management (APM), formalising the entity taxonomy of The Open Group Architecture Framework (TOGAF) Content Metamodel and integrating it with the software asset management concepts defined by the ISO/IEC 19770 standard family." .

### --------------------------------------------------
### CLASSES (Taxonomy)
### --------------------------------------------------

# TOGAF Content Metamodel Classes
# [1] The Open Group, "TOGAF® Version 9.2 -- Content Metamodel," The Open Group,
#     Reading, U.K., 2018. [Online]. Available:
#     https://pubs.opengroup.org/architecture/togaf9-doc/arch/chap30.html

apm:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A person, organisation, or system that initiates or participates in business activities." .

apm:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "The function an actor performs in a process, independent of who fulfils it." .

apm:OrganizationUnit a owl:Class ;
    rdfs:label "Organization Unit" ;
    rdfs:comment "A self-contained unit of the enterprise with defined management responsibility." .

apm:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A place where business activities are performed or architecture elements operate." .

apm:BusinessFunction a owl:Class ;
    rdfs:label "Business Function" ;
    rdfs:comment "A unit of business behaviour that delivers capability, independent of organisational structure." .

apm:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A sequence of activities that realises one or more business functions." .

apm:BusinessService a owl:Class ;
    rdfs:label "Business Service" ;
    rdfs:comment "A unit of business functionality, exposed through a defined interface, that supports a capability." .

apm:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" ;
    rdfs:comment "An ability the business has to deliver value, independent of how it is implemented." .

apm:LogicalApplicationComponent a owl:Class ;
    rdfs:label "Logical Application Component" ;
    rdfs:comment "An encapsulation of application functionality, independent of vendor or technology." .

apm:PhysicalApplicationComponent a owl:Class ;
    rdfs:label "Physical Application Component" ;
    rdfs:comment "A deployable instance that realises one or more logical application components." .

apm:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "The core APM asset: a catalogued software system that realises logical components and supports business capabilities." .

apm:DataEntity a owl:Class ;
    rdfs:label "Data Entity" ;
    rdfs:comment "A business-recognised concept of data, independent of its implementation." .

apm:LogicalDataComponent a owl:Class ;
    rdfs:label "Logical Data Component" ;
    rdfs:comment "A structured grouping of data entities, independent of implementation." .

apm:PhysicalDataComponent a owl:Class ;
    rdfs:label "Physical Data Component" ;
    rdfs:comment "An implementation-specific realisation of a logical data component, such as a database or file." .

apm:TechnologyService a owl:Class ;
    rdfs:label "Technology Service" ;
    rdfs:comment "A technical capability supporting application and infrastructure services." .

apm:LogicalTechnologyComponent a owl:Class ;
    rdfs:label "Logical Technology Component" ;
    rdfs:comment "An encapsulation of technology infrastructure, independent of vendor or product." .

apm:PhysicalTechnologyComponent a owl:Class ;
    rdfs:label "Physical Technology Component" ;
    rdfs:comment "A deployable technology product, such as a server or network device, that realises a logical technology component." .


## ISO/IEC 19770 Standard Classes
# [2] International Organization for Standardization, "ISO/IEC 19770-2:2015 --
#     Information technology -- IT asset management -- Part 2: Software
#     identification tag," ISO, Geneva, Switzerland, 2015. [Online]. Available:
#     https://www.iso.org/standard/65666.html
# [3] International Organization for Standardization, "ISO/IEC 19770-3:2016 --
#     Information technology -- IT asset management -- Part 3: Entitlement
#     schema," ISO, Geneva, Switzerland, 2016. [Online]. Available:
#     https://www.iso.org/standard/52293.html

apm:SoftwareProduct a owl:Class ; # ISO-19770-2
    rdfs:label "Software Product (ISO 19770-2)" ;
    rdfs:comment "A software asset identified via a SWID tag, per ISO/IEC 19770-2." .

apm:SoftwareEntitlement a owl:Class ; # ISO-19770-3
    rdfs:label "Software Entitlement (ISO 19770-3)" ;
    rdfs:comment "The legal usage rights held for a software asset, per ISO/IEC 19770-3." .

apm:Metric a owl:Class ; # ISO-19770-3
    rdfs:label "Metric" ;
    rdfs:comment "The unit used to measure a software entitlement, such as per-user or per-device." .


# Extension Classes (Nexus Insight APM Ontology)

apm:Portfolio a owl:Class ;
    rdfs:label "Portfolio" ;
    rdfs:comment "A curated grouping of applications, managed together for strategic, budgetary, or governance purposes." .

apm:ApplicationContact a owl:Class ;
    rdfs:label "Application Contact" ;
    rdfs:comment "An assignment of an actor to a specific contact role for an application, such as CTO or Information Owner." .

apm:ApplicationDependency a owl:Class ;
    rdfs:label "Application Dependency" ;
    rdfs:comment "A directed dependency between two applications, capturing how one relies on the other." .

apm:TechnologyDependency a owl:Class ;
    rdfs:label "Technology Dependency" ;
    rdfs:comment "A directed dependency between two physical technology components, capturing how one relies on the other." .

apm:LinkedResource a owl:Class ;
    rdfs:label "Linked Resource" ;
    rdfs:comment "An external reference with an accessible location, such as a document or code repository." .

apm:Document a owl:Class ;
    rdfs:subClassOf apm:LinkedResource ;
    rdfs:label "Document" ;
    rdfs:comment "A reference document or link associated with an application, such as an architecture or threat model document." .

apm:DocumentType a owl:Class ;
    rdfs:label "Document Type" ;
    rdfs:comment "A classification of a document's purpose, such as Architecture or Threat Model." .

apm:CodeRepository a owl:Class ;
    rdfs:subClassOf apm:LinkedResource ;
    rdfs:label "Code Repository" ;
    rdfs:comment "A source code repository containing the implementation of an application." .

apm:LifecycleStatus a owl:Class ;
    rdfs:label "Lifecycle Status" ;
    rdfs:comment "A classification of an application's position in its lifecycle, such as Planned, Development, Operate, or Retired." .

apm:CriticalityTier a owl:Class ;
    rdfs:label "Criticality Tier" ;
    rdfs:comment "A classification of an application's business criticality, such as Critical, High, Medium, or Low." .

# [4] R. Kusumarani and R. P. A. Pramesti, "Exploring application portfolio
#     management in Indonesia: A case study of the Indonesia agency for the
#     assessment and application of technology," Computer Science and
#     Information Technologies, vol. 4, no. 1, pp. 76-84, 2023,
#     doi: 10.11591/csit.v4i1.p76-84.

apm:InvestmentStrategy a owl:Class ;
    rdfs:label "Investment Strategy (Gartner TIME)" ;
    rdfs:comment "A classification of the funding decision made for an application, per Gartner's Tolerate, Invest, Migrate, Eliminate (TIME) model." .


### --------------------------------------------------
### RELATIONSHIPS (Object Properties)
### --------------------------------------------------

# Business Domain Relationships

apm:performsRole a owl:ObjectProperty ;
    rdfs:label "performs role" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:Role ;
    rdfs:comment "An actor in the organisation performs a role." .

apm:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:OrganizationUnit ;
    rdfs:comment "An actor holds a line-management and reporting responsibilities to an organizational Unit." .

apm:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at" ;
    rdfs:domain apm:OrganizationUnit ;
    rdfs:range apm:Location ;
    rdfs:comment "An organizational unit operates at certain location." .

apm:performsProcess a owl:ObjectProperty ;
    rdfs:label "performs process" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:BusinessProcess ;
    rdfs:comment "An actor carries out activities in a business process." .

apm:realizesFunction a owl:ObjectProperty ;
    rdfs:label "realizes function" ;
    rdfs:domain apm:BusinessProcess ;
    rdfs:range apm:BusinessFunction ;
    rdfs:comment "A business process operationalises one or more business functions through a defined sequence of activities." .

apm:supportsCapability a owl:ObjectProperty ;
    rdfs:label "supports capability" ;
    rdfs:domain apm:BusinessService ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "A business service enables a capability through its well defined interface." .


# Application Domain Relationships

apm:realizesLogicalComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical component" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:LogicalApplicationComponent ;
    rdfs:comment "A physical application component implements its logical abstraction." .

apm:comprisesLogicalComponent a owl:ObjectProperty ;
    rdfs:label "comprises logical component" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:LogicalApplicationComponent ;
    rdfs:comment "An application, as a portfolio asset, is linked to one or more logical application components it is composed of. This is a whole/part relationship" .

apm:hasDeployment a owl:ObjectProperty ;
    rdfs:label "has deployment" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:PhysicalApplicationComponent ;
    rdfs:comment "An application, as a portfolio asset, is directly linked to each of its concrete deployed instances." .

apm:enablesCapability a owl:ObjectProperty ;
    rdfs:label "enables capability" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "An application enables business capabilities, providing traceability from the technology portfolio to business value." .

apm:accessesData a owl:ObjectProperty ;
    rdfs:label "accesses data" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:DataEntity ;
    rdfs:comment "An application has to access the data entities it creates, reads, updates, or deletes in the course of its operation." .

apm:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Actor ;
    rdfs:comment "An application has an owner who maintains its lifecycle." .

apm:managedByOrganizationUnit a owl:ObjectProperty ;
    rdfs:label "managed by organization unit" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:OrganizationUnit ;
    rdfs:comment "An organizational unit is responsible for its application operation and governance." .


# Data Domain Relationships

apm:encapsulatesDataEntity a owl:ObjectProperty ;
    rdfs:label "encapsulates data entity" ;
    rdfs:domain apm:LogicalDataComponent ;
    rdfs:range apm:DataEntity ;
    rdfs:comment "Relates a logical data component to the one or more data entities it structures and manages." .

apm:realizesLogicalDataComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical data component" ;
    rdfs:domain apm:PhysicalDataComponent ;
    rdfs:range apm:LogicalDataComponent ;
    rdfs:comment "Relates a physical data component to the logical data component it implements." .


# Technology Domain Relationships

apm:deployedOn a owl:ObjectProperty ;
    rdfs:label "deployed on" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "Physical componentns hosts application components execution." .

apm:realizesLogicalTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical technology component" ;
    rdfs:domain apm:PhysicalTechnologyComponent ;
    rdfs:range apm:LogicalTechnologyComponent ;
    rdfs:comment Physical technology component implements its logical counterpart." .

apm:providesTechnologyService a owl:ObjectProperty ;
    rdfs:label "provides technology service" ;
    rdfs:domain apm:LogicalTechnologyComponent ;
    rdfs:range apm:TechnologyService ;
    rdfs:comment "Make technology components available to consuming applications." .

apm:usesTechnologyService a owl:ObjectProperty ;
    rdfs:label "uses technology service" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:TechnologyService ;
    rdfs:comment "Application consumes technology services to operate." .


# ISO/IEC 19770 Cross-Cutting Relationships

apm:identifiedBy a owl:ObjectProperty ;
    rdfs:label "identified by" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:SoftwareProduct ;
    rdfs:comment "An installed software assert record relates to the physical application component it constitutes" .

apm:coveredByEntitlement a owl:ObjectProperty ;
    rdfs:label "covered by entitlement" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range apm:SoftwareEntitlement ;
    rdfs:comment "An entitlement documents the legal rights authorising the software product's use." .

apm:measuredByMetric a owl:ObjectProperty ;
    rdfs:label "measured by metric" ;
    rdfs:domain apm:SoftwareEntitlement ;
    rdfs:range apm:Metric ;
    rdfs:comment "The grant of rights and consumption are assessed by a metric." .


# Extension Relationships (Nexus Insight APM Ontology)

apm:containsApplication a owl:ObjectProperty ;
    rdfs:label "contains application" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:Application ;
    rdfs:comment "A portfolio groups an application for governance purposes." .

apm:portfolioOwner a owl:ObjectProperty ;
    rdfs:label "portfolio owner" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:Actor ;
    rdfs:comment "An actor is accountable for a portfolio's strategic governance." .

apm:alignsToCapability a owl:ObjectProperty ;
    rdfs:label "aligns to capability" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "A portfolio is organised around a business capability." .

apm:forApplication a owl:ObjectProperty ;
    rdfs:label "for application" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Application ;
    rdfs:comment "A contact assignment is made for a specific application." .

apm:contactActor a owl:ObjectProperty ;
    rdfs:label "contact actor" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Actor ;
    rdfs:comment "A contact assignment names the actor who fulfils it." .

apm:contactRole a owl:ObjectProperty ;
    rdfs:label "contact role" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Role ;
    rdfs:comment "A contact assignment specifies the role the actor serves in, such as CTO or Information Owner." .

apm:upstreamApplication a owl:ObjectProperty ;
    rdfs:label "upstream application" ;
    rdfs:domain apm:ApplicationDependency ;
    rdfs:range apm:Application ;
    rdfs:comment "A dependency names the application that provides the capability being relied upon." .

apm:downstreamApplication a owl:ObjectProperty ;
    rdfs:label "downstream application" ;
    rdfs:domain apm:ApplicationDependency ;
    rdfs:range apm:Application ;
    rdfs:comment "A dependency names the application that consumes the upstream application's capability." .

apm:upstreamTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "upstream technology component" ;
    rdfs:domain apm:TechnologyDependency ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A dependency names the technology component that provides the capability being relied upon." .

apm:downstreamTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "downstream technology component" ;
    rdfs:domain apm:TechnologyDependency ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A dependency names the technology component that consumes the upstream component's capability." .

apm:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Document ;
    rdfs:comment "An application is linked to a reference document, such as an architecture or threat model document." .

apm:hasDocumentType a owl:ObjectProperty ;
    rdfs:label "has document type" ;
    rdfs:domain apm:Document ;
    rdfs:range apm:DocumentType ;
    rdfs:comment "A document is classified by the type of reference material it represents." .

apm:hasRepository a owl:ObjectProperty ;
    rdfs:label "has repository" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:CodeRepository ;
    rdfs:comment "An application is linked to a source code repository containing its implementation." .

apm:hasLifecycleStatus a owl:ObjectProperty ;
    rdfs:label "has lifecycle status" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:LifecycleStatus ;
    rdfs:comment "An application is classified by its current lifecycle status." .

apm:hasCriticalityTier a owl:ObjectProperty ;
    rdfs:label "has criticality tier" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:CriticalityTier ;
    rdfs:comment "An application is classified by its business criticality tier." .

apm:hasInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "has investment strategy" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:InvestmentStrategy ;
    rdfs:comment "An application is classified by the funding decision made for it." .


### --------------------------------------------------
### DATATYPE PROPERTIES
### --------------------------------------------------

apm:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:domain apm:LinkedResource ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The location at which a linked resource can be accessed." .


### --------------------------------------------------
### INDIVIDUALS (Controlled Vocabulary)
### --------------------------------------------------

# Lifecycle Status

apm:Planned a apm:LifecycleStatus ;
    rdfs:label "Planned" ;
    rdfs:comment "The application is planned but not yet in development." .

apm:Development a apm:LifecycleStatus ;
    rdfs:label "Development" ;
    rdfs:comment "The application is being built and is not yet in production use." .

apm:Operate a apm:LifecycleStatus ;
    rdfs:label "Operate" ;
    rdfs:comment "The application is in production use." .

apm:Retired a apm:LifecycleStatus ;
    rdfs:label "Retired" ;
    rdfs:comment "The application has been decommissioned and is no longer in use." .


# Criticality Tier

apm:Critical a apm:CriticalityTier ;
    rdfs:label "Critical" ;
    rdfs:comment "An outage would cause severe disruption to the business." .

apm:High a apm:CriticalityTier ;
    rdfs:label "High" ;
    rdfs:comment "An outage would cause significant disruption to the business." .

apm:Medium a apm:CriticalityTier ;
    rdfs:label "Medium" ;
    rdfs:comment "An outage would cause moderate disruption to the business." .

apm:Low a apm:CriticalityTier ;
    rdfs:label "Low" ;
    rdfs:comment "An outage would cause minimal disruption to the business." .


# Investment Strategy (Gartner TIME) [4]

apm:Tolerate a apm:InvestmentStrategy ;
    rdfs:label "Tolerate" ;
    rdfs:comment "High technical fit but low business fit; kept running as-is since it is cheap to maintain." .

apm:Invest a apm:InvestmentStrategy ;
    rdfs:label "Invest" ;
    rdfs:comment "High technical fit and high business fit; funding is committed to grow or enhance the application." .

apm:Migrate a apm:InvestmentStrategy ;
    rdfs:label "Migrate" ;
    rdfs:comment "Low technical fit but high business fit; a valuable capability in need of a technical replacement." .

apm:Eliminate a apm:InvestmentStrategy ;
    rdfs:label "Eliminate" ;
    rdfs:comment "Low technical fit and low business fit; the application is a candidate for retirement." .
