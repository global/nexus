@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix apm: <http://nexus-apm.org/ontology/apm#> .


###################################################################
# Nexus Insight — Application Portfolio Management (APM) Ontology #
###################################################################

<http://nexus-apm.org> a owl:Ontology ;
    dct:title "Nexus Insight Application Portfolio Management (APM) Ontology" ;
    dct:creator "Anderson Goulart" ;
    dct:created "2026-06-20"^^xsd:date ;
    dct:modified "2026-08-02"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.0" ;
    rdfs:comment "A unified ontology for Application Portfolio Management (APM), formalising the entity taxonomy of The Open Group Architecture Framework (TOGAF) Content Metamodel and integrating it with the software asset management concepts defined by the ISO/IEC 19770 standard family." .

### --------------------------------------------------
### CLASSES (Taxonomy)
### --------------------------------------------------

# TOGAF Content Metamodel Classes
# [1] The Open Group, "TOGAF® Version 9.2 -- Content Metamodel," The Open Group,
#     Reading, U.K., 2018. [Online]. Available:
#     https://pubs.opengroup.org/architecture/togaf9-doc/arch/chap30.html

apm:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A person, organisation, or system that initiates or participates in business activities." .

apm:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "The function an actor performs in a process, independent of who fulfils it." .

apm:OrganizationUnit a owl:Class ;
    rdfs:label "Organization Unit" ;
    rdfs:comment "A self-contained unit of the enterprise with defined management responsibility." .

apm:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A place where business activities are performed or architecture elements operate." .

apm:BusinessFunction a owl:Class ;
    rdfs:label "Business Function" ;
    rdfs:comment "A unit of business behaviour that delivers capability, independent of organisational structure." .

apm:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "A sequence of activities that realises one or more business functions." .

apm:BusinessService a owl:Class ;
    rdfs:label "Business Service" ;
    rdfs:comment "A unit of business functionality, exposed through a defined interface, that supports a capability." .

apm:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" ;
    rdfs:comment "An ability the business has to deliver value, independent of how it is implemented." .

apm:LogicalApplicationComponent a owl:Class ;
    rdfs:label "Logical Application Component" ;
    rdfs:comment "An encapsulation of application functionality, independent of vendor or technology." .

apm:PhysicalApplicationComponent a owl:Class ;
    rdfs:label "Physical Application Component" ;
    rdfs:comment "A deployable instance that realises one or more logical application components." .

apm:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "The core APM asset: a catalogued software system that realises logical components and supports business capabilities." .

apm:DataEntity a owl:Class ;
    rdfs:label "Data Entity" ;
    rdfs:comment "A business-recognised concept of data, independent of its implementation." .

apm:LogicalDataComponent a owl:Class ;
    rdfs:label "Logical Data Component" ;
    rdfs:comment "A structured grouping of data entities, independent of implementation." .

apm:PhysicalDataComponent a owl:Class ;
    rdfs:label "Physical Data Component" ;
    rdfs:comment "An implementation-specific realisation of a logical data component, such as a database or file." .

apm:TechnologyService a owl:Class ;
    rdfs:label "Technology Service" ;
    rdfs:comment "A technical capability supporting application and infrastructure services." .

apm:LogicalTechnologyComponent a owl:Class ;
    rdfs:label "Logical Technology Component" ;
    rdfs:comment "An encapsulation of technology infrastructure, independent of vendor or product." .

apm:PhysicalTechnologyComponent a owl:Class ;
    rdfs:label "Physical Technology Component" ;
    rdfs:comment "A deployable technology product, such as a server or network device, that realises a logical technology component." .


## ISO/IEC 19770 Standard Classes
# [2] International Organization for Standardization, "ISO/IEC 19770-2:2015 --
#     Information technology -- IT asset management -- Part 2: Software
#     identification tag," ISO, Geneva, Switzerland, 2015. [Online]. Available:
#     https://www.iso.org/standard/65666.html
# [3] International Organization for Standardization, "ISO/IEC 19770-3:2016 --
#     Information technology -- IT asset management -- Part 3: Entitlement
#     schema," ISO, Geneva, Switzerland, 2016. [Online]. Available:
#     https://www.iso.org/standard/52293.html
# [5] International Organization for Standardization, "ISO/IEC 19770-1:2017 --
#     Information technology -- IT asset management -- Part 1: IT asset
#     management systems -- Requirements," ISO, Geneva, Switzerland, 2017.
#     [Online]. Available: https://www.iso.org/standard/68531.html
# [10] International Organization for Standardization, "ISO/IEC 19770-4:2017 --
#      Information technology -- IT asset management -- Part 4: Resource
#      utilization measurement," ISO/IEC, Geneva, Switzerland, 2017.
#      [Online]. Available: https://www.iso.org/standard/68431.html

apm:SoftwareProduct a owl:Class ; # ISO-19770-2
    rdfs:label "Software Product (ISO 19770-2)" ;
    rdfs:comment "A software asset identified via a SWID tag, per ISO/IEC 19770-2." .

apm:SoftwareEntitlement a owl:Class ; # ISO-19770-3
    rdfs:label "Software Entitlement (ISO 19770-3)" ;
    rdfs:comment "The legal usage rights held for a software asset, per ISO/IEC 19770-3." .

apm:Metric a owl:Class ; # ISO-19770-3
    rdfs:label "Metric" ;
    rdfs:comment "The unit used to measure a software entitlement, such as per-user or per-device." .

apm:ResourceUtilizationRecord a owl:Class ; # ISO-19770-4
    rdfs:label "Resource Utilization Record (ISO 19770-4)" ;
    rdfs:comment "A recorded measurement of actual resource consumption for a software product over a specific period, per ISO/IEC 19770-4." .


# Extension Classes (Nexus Insight APM Ontology)

apm:Portfolio a owl:Class ;
    rdfs:label "Portfolio" ;
    rdfs:comment "A curated grouping of applications, managed together for strategic, budgetary, or governance purposes." .

apm:ApplicationContact a owl:Class ;
    rdfs:label "Application Contact" ;
    rdfs:comment "An assignment of an actor to a specific contact role for an application, such as CTO or Information Owner." .

apm:Dependency a owl:Class ;
    rdfs:label "Dependency" ;
    rdfs:comment "A directed reliance of one asset on another, describing the protocol(s) used and the synchronicity of the interaction." .

apm:ApplicationDependency a owl:Class ;
    rdfs:subClassOf apm:Dependency ;
    rdfs:label "Application Dependency" ;
    rdfs:comment "A directed dependency between two applications, capturing how one relies on the other." .

apm:TechnologyDependency a owl:Class ;
    rdfs:subClassOf apm:Dependency ;
    rdfs:label "Technology Dependency" ;
    rdfs:comment "A directed dependency between two physical technology components, capturing how one relies on the other." .

apm:DependencyProtocol a owl:Class ;
    rdfs:label "Dependency Protocol" ;
    rdfs:comment "An open, extensible classification of the technical protocol used by a dependency, such as REST API, Message Queue, or File Transfer." .

apm:Synchronicity a owl:Class ;
    rdfs:label "Synchronicity" ;
    rdfs:comment "A classification of how a dependency's interaction is timed, such as Synchronous, Asynchronous, or Batch." .

apm:LinkedResource a owl:Class ;
    rdfs:label "Linked Resource" ;
    rdfs:comment "An external reference with an accessible location, such as a document or code repository." .

apm:Document a owl:Class ;
    rdfs:subClassOf apm:LinkedResource ;
    rdfs:label "Document" ;
    rdfs:comment "A reference document or link associated with an application, such as an architecture or threat model document." .

apm:DocumentType a owl:Class ;
    rdfs:label "Document Type" ;
    rdfs:comment "A classification of a document's purpose, such as Architecture or Threat Model." .

apm:CodeRepository a owl:Class ;
    rdfs:subClassOf apm:LinkedResource ;
    rdfs:label "Code Repository" ;
    rdfs:comment "A source code repository containing the implementation of an application." .

apm:LifecycleStatus a owl:Class ;
    rdfs:label "Lifecycle Status" ;
    rdfs:comment "A classification of an application's position in its lifecycle, such as Planned, Development, Operate, or Retired." .

apm:CriticalityTier a owl:Class ;
    rdfs:label "Criticality Tier" ;
    rdfs:comment "A classification of an application's business criticality, such as Critical, High, Medium, or Low." .

# [4] R. Kusumarani and R. P. A. Pramesti, "Exploring application portfolio
#     management in Indonesia: A case study of the Indonesia agency for the
#     assessment and application of technology," Computer Science and
#     Information Technologies, vol. 4, no. 1, pp. 76-84, 2023,
#     doi: 10.11591/csit.v4i1.p76-84.

apm:InvestmentStrategy a owl:Class ;
    rdfs:label "Investment Strategy (Gartner TIME)" ;
    rdfs:comment "A classification of the funding decision made for an application, per Gartner's Tolerate, Invest, Migrate, Eliminate (TIME) model." .

apm:ComplianceStandard a owl:Class ;
    rdfs:label "Compliance Standard" ;
    rdfs:comment "An industry-wide compliance standard, such as SOC 2 or HIPAA, that an application may be required to meet." .

apm:HostingModel a owl:Class ;
    rdfs:label "Hosting Model" ;
    rdfs:comment "A classification of where an application's infrastructure is hosted, such as Externally Hosted, Internally Hosted, or Hybrid." .

apm:CostRecord a owl:Class ;
    rdfs:label "Cost Record" ;
    rdfs:comment "A recorded cost incurred by an application for a specific fiscal year and cost category." .

apm:CostCategory a owl:Class ;
    rdfs:label "Cost Category" ;
    rdfs:comment "A classification of cost type, such as Licensing, Infrastructure, Support, or Labor." .

# [8] International Organization for Standardization, "ISO/IEC 27005:2022 --
#     Information security, cybersecurity and privacy protection -- Guidance
#     on managing information security risks," ISO/IEC, Geneva, Switzerland,
#     2022. [Online]. Available: https://www.iso.org/standard/80585.html
# [9] International Organization for Standardization, "ISO 31000:2018 --
#     Risk management -- Guidelines," ISO, Geneva, Switzerland, 2018.
#     [Online]. Available: https://www.iso.org/standard/65694.html

apm:Finding a owl:Class ; # [8][9]
    rdfs:label "Finding" ;
    rdfs:comment "A recorded vulnerability, technical risk, business risk, or control gap identified against an application or technology component, tracked through its remediation lifecycle." .

apm:FindingCategory a owl:Class ;
    rdfs:label "Finding Category" ;
    rdfs:comment "A classification of a finding's nature, such as Vulnerability, Technical Risk, Business Risk, or Control Gap." .

apm:FindingStatus a owl:Class ;
    rdfs:label "Finding Status" ;
    rdfs:comment "A classification of a finding's position in its remediation lifecycle, such as Open, In Remediation, Remediated, Risk Accepted, or Closed." .

# [7] International Organization for Standardization, "ISO/IEC 27002:2022 --
#     Information security, cybersecurity and privacy protection --
#     Information security controls," ISO/IEC, Geneva, Switzerland, 2022.
#     [Online]. Available: https://www.iso.org/standard/75652.html

apm:Control a owl:Class ; # [7]
    rdfs:label "Control" ;
    rdfs:comment "A safeguard or measure implemented to mitigate risk or satisfy a compliance requirement." .

apm:ImpactType a owl:Class ;
    rdfs:label "Impact Type" ;
    rdfs:comment "An open classification of the consequence a finding could cause if left unaddressed, such as Data Breach, Service Outage, Regulatory Fine, or Reputational Damage." .

apm:DataSensitivity a owl:Class ;
    rdfs:label "Data Sensitivity" ;
    rdfs:comment "A classification of a data entity's sensitivity, such as Public, Internal, Confidential, PII, or PHI." .

apm:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "A third-party vendor that publishes a software product or hosts an application on the organization's behalf." .

apm:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment" ;
    rdfs:comment "A point-in-time evaluation of an application's business and technical fit, enabling trend tracking across assessment cycles." .

apm:ServiceLevelAgreement a owl:Class ;
    rdfs:label "Service Level Agreement" ;
    rdfs:comment "A recorded service level agreement for an application, covering a specific effective period and one or more owner-defined metrics." .

apm:SLAMetric a owl:Class ;
    rdfs:label "SLA Metric" ;
    rdfs:comment "A single measurable commitment within an SLA, defined by an open category and a target value with its unit of measure." .

apm:SLACategory a owl:Class ;
    rdfs:label "SLA Category" ;
    rdfs:comment "An open, extensible classification of the kind of service level being measured. Application owners may define new categories, such as Availability, Throughput, or Response Time, as needed." .

apm:Environment a owl:Class ;
    rdfs:label "Environment" ;
    rdfs:comment "A classification of the deployment tier in which a physical component operates, such as Production, Staging, Development, Test, or Disaster Recovery." .


### --------------------------------------------------
### DISJOINTNESS AXIOMS
### --------------------------------------------------
# Declares that distinct classes at the same level of the taxonomy cannot
# share an instance (e.g., something cannot be both an Application and a
# Portfolio). Classes related by rdfs:subClassOf are deliberately excluded
# from the group containing their ancestor, and are instead only declared
# disjoint from their direct siblings, to avoid an unsatisfiable class.

# Core entity classes (the "real world" things the ontology describes)
[] a owl:AllDisjointClasses ;
    owl:members (
        apm:Actor apm:Role apm:OrganizationUnit apm:Location
        apm:BusinessFunction apm:BusinessProcess apm:BusinessService apm:BusinessCapability
        apm:LogicalApplicationComponent apm:PhysicalApplicationComponent apm:Application
        apm:DataEntity apm:LogicalDataComponent apm:PhysicalDataComponent
        apm:TechnologyService apm:LogicalTechnologyComponent apm:PhysicalTechnologyComponent
        apm:SoftwareProduct apm:SoftwareEntitlement apm:Metric apm:ResourceUtilizationRecord
        apm:Portfolio apm:ApplicationContact apm:Dependency apm:LinkedResource
        apm:Control apm:Finding apm:Supplier
        apm:PerformanceAssessment apm:ServiceLevelAgreement apm:SLAMetric apm:CostRecord
    ) .

# Controlled-vocabulary / classification classes
[] a owl:AllDisjointClasses ;
    owl:members (
        apm:LifecycleStatus apm:CriticalityTier apm:InvestmentStrategy apm:ComplianceStandard
        apm:HostingModel apm:CostCategory apm:FindingCategory apm:FindingStatus
        apm:ImpactType apm:DataSensitivity apm:SLACategory apm:Environment
        apm:DependencyProtocol apm:Synchronicity apm:DocumentType
    ) .

# Sibling subclasses of apm:Dependency
[] a owl:AllDisjointClasses ;
    owl:members ( apm:ApplicationDependency apm:TechnologyDependency ) .

# Sibling subclasses of apm:LinkedResource
[] a owl:AllDisjointClasses ;
    owl:members ( apm:Document apm:CodeRepository ) .


### --------------------------------------------------
### RELATIONSHIPS (Object Properties)
### --------------------------------------------------

# Business Domain Relationships

apm:performsRole a owl:ObjectProperty ;
    rdfs:label "performs role" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:Role ;
    rdfs:comment "An actor in the organisation performs a role." .

apm:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:OrganizationUnit ;
    rdfs:comment "An actor holds a line-management and reporting responsibilities to an organizational Unit." .

apm:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at" ;
    rdfs:domain apm:OrganizationUnit ;
    rdfs:range apm:Location ;
    rdfs:comment "An organizational unit operates at certain location." .

apm:performsProcess a owl:ObjectProperty ;
    rdfs:label "performs process" ;
    rdfs:domain apm:Actor ;
    rdfs:range apm:BusinessProcess ;
    rdfs:comment "An actor carries out activities in a business process." .

apm:realizesFunction a owl:ObjectProperty ;
    rdfs:label "realizes function" ;
    rdfs:domain apm:BusinessProcess ;
    rdfs:range apm:BusinessFunction ;
    rdfs:comment "A business process operationalises one or more business functions through a defined sequence of activities." .

apm:supportsCapability a owl:ObjectProperty ;
    rdfs:label "supports capability" ;
    rdfs:domain apm:BusinessService ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "A business service enables a capability through its well defined interface." .

apm:subCapabilityOf a owl:ObjectProperty ;
    rdfs:label "sub-capability of" ;
    rdfs:domain apm:BusinessCapability ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "Relates a business capability to the parent capability it decomposes, enabling a hierarchical capability map (e.g., L1/L2/L3)." .


# Application Domain Relationships

apm:realizesLogicalComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical component" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:LogicalApplicationComponent ;
    rdfs:comment "A physical application component implements its logical abstraction." .

apm:comprisesLogicalComponent a owl:ObjectProperty ;
    rdfs:label "comprises logical component" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:LogicalApplicationComponent ;
    rdfs:comment "An application, as a portfolio asset, is linked to one or more logical application components it is composed of. This is a whole/part relationship" .

apm:hasDeployment a owl:ObjectProperty ;
    rdfs:label "has deployment" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:PhysicalApplicationComponent ;
    rdfs:comment "An application, as a portfolio asset, is directly linked to each of its concrete deployed instances." .

apm:enablesCapability a owl:ObjectProperty ;
    rdfs:label "enables capability" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "An application enables business capabilities, providing traceability from the technology portfolio to business value." .

apm:accessesData a owl:ObjectProperty ;
    rdfs:label "accesses data" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:DataEntity ;
    rdfs:comment "An application has to access the data entities it creates, reads, updates, or deletes in the course of its operation." .

apm:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Actor ;
    rdfs:comment "An application has an owner who maintains its lifecycle." .

apm:managedByOrganizationUnit a owl:ObjectProperty ;
    rdfs:label "managed by organization unit" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:OrganizationUnit ;
    rdfs:comment "An organizational unit is responsible for its application operation and governance." .


# Data Domain Relationships

apm:encapsulatesDataEntity a owl:ObjectProperty ;
    rdfs:label "encapsulates data entity" ;
    rdfs:domain apm:LogicalDataComponent ;
    rdfs:range apm:DataEntity ;
    rdfs:comment "Relates a logical data component to the one or more data entities it structures and manages." .

apm:realizesLogicalDataComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical data component" ;
    rdfs:domain apm:PhysicalDataComponent ;
    rdfs:range apm:LogicalDataComponent ;
    rdfs:comment "Relates a physical data component to the logical data component it implements." .

apm:hasDataSensitivity a owl:ObjectProperty ;
    rdfs:label "has data sensitivity" ;
    rdfs:domain apm:DataEntity ;
    rdfs:range apm:DataSensitivity ;
    rdfs:comment "A data entity is classified by its sensitivity level." .


# Technology Domain Relationships

apm:deployedOn a owl:ObjectProperty ;
    rdfs:label "deployed on" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A physical technology component hosts the execution of a physical application component." .

apm:hasEnvironment a owl:ObjectProperty ;
    rdfs:label "has environment" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( apm:PhysicalApplicationComponent apm:PhysicalTechnologyComponent )
    ] ;
    rdfs:range apm:Environment ;
    rdfs:comment "A physical application or technology component is classified by the deployment tier in which it operates, such as Production, Staging, Development, or Test." .

apm:realizesLogicalTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "realizes logical technology component" ;
    rdfs:domain apm:PhysicalTechnologyComponent ;
    rdfs:range apm:LogicalTechnologyComponent ;
    rdfs:comment "Physical technology component implements its logical counterpart." .

apm:providesTechnologyService a owl:ObjectProperty ;
    rdfs:label "provides technology service" ;
    rdfs:domain apm:LogicalTechnologyComponent ;
    rdfs:range apm:TechnologyService ;
    rdfs:comment "Make technology components available to consuming applications." .

apm:usesTechnologyService a owl:ObjectProperty ;
    rdfs:label "uses technology service" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:TechnologyService ;
    rdfs:comment "Application consumes technology services to operate." .


# ISO/IEC 19770 Cross-Cutting Relationships

apm:identifiedBy a owl:ObjectProperty ;
    rdfs:label "identified by" ;
    rdfs:domain apm:PhysicalApplicationComponent ;
    rdfs:range apm:SoftwareProduct ;
    rdfs:comment "A physical application component is identified by the installed software asset record it constitutes." .

apm:coveredByEntitlement a owl:ObjectProperty ;
    rdfs:label "covered by entitlement" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range apm:SoftwareEntitlement ;
    rdfs:comment "An entitlement documents the legal rights authorising the software product's use." .

apm:measuredByMetric a owl:ObjectProperty ;
    rdfs:label "measured by metric" ;
    rdfs:domain apm:SoftwareEntitlement ;
    rdfs:range apm:Metric ;
    rdfs:comment "The grant of rights and consumption are assessed by a metric." .

apm:suppliedBy a owl:ObjectProperty ;
    rdfs:label "supplied by" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range apm:Supplier ;
    rdfs:comment "A software product is published by a supplier." .

apm:measuresProduct a owl:ObjectProperty ; # ISO-19770-4
    rdfs:label "measures product" ;
    rdfs:domain apm:ResourceUtilizationRecord ;
    rdfs:range apm:SoftwareProduct ;
    rdfs:comment "A resource utilization record measures actual consumption of a specific software product." .

apm:measuredAgainstMetric a owl:ObjectProperty ; # ISO-19770-4
    rdfs:label "measured against metric" ;
    rdfs:domain apm:ResourceUtilizationRecord ;
    rdfs:range apm:Metric ;
    rdfs:comment "A resource utilization record is expressed against the same metric used to define the product's entitlement, enabling direct usage-versus-entitlement comparison." .


# Extension Relationships (Nexus Insight APM Ontology)

apm:containsApplication a owl:ObjectProperty ;
    rdfs:label "contains application" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:Application ;
    rdfs:comment "A portfolio groups an application for governance purposes." .

apm:portfolioOwner a owl:ObjectProperty ;
    rdfs:label "portfolio owner" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:Actor ;
    rdfs:comment "An actor is accountable for a portfolio's strategic governance." .

apm:alignsToCapability a owl:ObjectProperty ;
    rdfs:label "aligns to capability" ;
    rdfs:domain apm:Portfolio ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "A portfolio is organised around a business capability." .

apm:forApplication a owl:ObjectProperty ;
    rdfs:label "for application" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Application ;
    rdfs:comment "A contact assignment is made for a specific application." .

apm:contactActor a owl:ObjectProperty ;
    rdfs:label "contact actor" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Actor ;
    rdfs:comment "A contact assignment names the actor who fulfils it." .

apm:contactRole a owl:ObjectProperty ;
    rdfs:label "contact role" ;
    rdfs:domain apm:ApplicationContact ;
    rdfs:range apm:Role ;
    rdfs:comment "A contact assignment specifies the role the actor serves in, such as CTO or Information Owner." .

apm:upstreamApplication a owl:ObjectProperty ;
    rdfs:label "upstream application" ;
    rdfs:domain apm:ApplicationDependency ;
    rdfs:range apm:Application ;
    rdfs:comment "A dependency names the application that provides the capability being relied upon." .

apm:downstreamApplication a owl:ObjectProperty ;
    rdfs:label "downstream application" ;
    rdfs:domain apm:ApplicationDependency ;
    rdfs:range apm:Application ;
    rdfs:comment "A dependency names the application that consumes the upstream application's capability." .

apm:upstreamTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "upstream technology component" ;
    rdfs:domain apm:TechnologyDependency ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A dependency names the technology component that provides the capability being relied upon." .

apm:downstreamTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "downstream technology component" ;
    rdfs:domain apm:TechnologyDependency ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A dependency names the technology component that consumes the upstream component's capability." .

apm:usesProtocol a owl:ObjectProperty ;
    rdfs:label "uses protocol" ;
    rdfs:domain apm:Dependency ;
    rdfs:range apm:DependencyProtocol ;
    rdfs:comment "A dependency is carried over one or more technical protocols." .

apm:hasSynchronicity a owl:ObjectProperty ;
    rdfs:label "has synchronicity" ;
    rdfs:domain apm:Dependency ;
    rdfs:range apm:Synchronicity ;
    rdfs:comment "A dependency is classified by the timing of its interaction, such as Synchronous, Asynchronous, or Batch." .

apm:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Document ;
    rdfs:comment "An application is linked to a reference document, such as an architecture or threat model document." .

apm:hasDocumentType a owl:ObjectProperty ;
    rdfs:label "has document type" ;
    rdfs:domain apm:Document ;
    rdfs:range apm:DocumentType ;
    rdfs:comment "A document is classified by the type of reference material it represents." .

apm:hasRepository a owl:ObjectProperty ;
    rdfs:label "has repository" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:CodeRepository ;
    rdfs:comment "An application is linked to a source code repository containing its implementation." .

apm:hasLifecycleStatus a owl:ObjectProperty ;
    rdfs:label "has lifecycle status" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:LifecycleStatus ;
    rdfs:comment "An application is classified by its current lifecycle status." .

apm:hasCriticalityTier a owl:ObjectProperty ;
    rdfs:label "has criticality tier" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:CriticalityTier ;
    rdfs:comment "An application is classified by its business criticality tier." .

apm:hasInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "has investment strategy" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:InvestmentStrategy ;
    rdfs:comment "An application is classified by the funding decision made for it." .

apm:requiresCompliance a owl:ObjectProperty ;
    rdfs:label "requires compliance" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:ComplianceStandard ;
    rdfs:comment "An application is subject to an industry-wide compliance standard, based on its regulatory or contractual obligations." .

apm:hasHostingModel a owl:ObjectProperty ;
    rdfs:label "has hosting model" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:HostingModel ;
    rdfs:comment "An application is classified by where its infrastructure is hosted." .

apm:hostedBySupplier a owl:ObjectProperty ;
    rdfs:label "hosted by supplier" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Supplier ;
    rdfs:comment "An application's infrastructure is hosted by an external supplier, such as a SaaS or cloud provider." .

apm:hasCertification a owl:ObjectProperty ;
    rdfs:label "has certification" ;
    rdfs:domain apm:Supplier ;
    rdfs:range apm:ComplianceStandard ;
    rdfs:comment "A supplier holds certification against an industry-wide compliance standard." .

apm:assessesApplication a owl:ObjectProperty ;
    rdfs:label "assesses application" ;
    rdfs:domain apm:PerformanceAssessment ;
    rdfs:range apm:Application ;
    rdfs:comment "A performance assessment evaluates a specific application." .

apm:assessedBy a owl:ObjectProperty ;
    rdfs:label "assessed by" ;
    rdfs:domain apm:PerformanceAssessment ;
    rdfs:range apm:Actor ;
    rdfs:comment "A performance assessment names the actor who conducted it." .

apm:appliesToApplication a owl:ObjectProperty ;
    rdfs:label "applies to application" ;
    rdfs:domain apm:ServiceLevelAgreement ;
    rdfs:range apm:Application ;
    rdfs:comment "A service level agreement is made for a specific application." .

apm:hasSLAMetric a owl:ObjectProperty ;
    rdfs:label "has SLA metric" ;
    rdfs:domain apm:ServiceLevelAgreement ;
    rdfs:range apm:SLAMetric ;
    rdfs:comment "A service level agreement is composed of one or more owner-defined metrics." .

apm:hasSLACategory a owl:ObjectProperty ;
    rdfs:label "has SLA category" ;
    rdfs:domain apm:SLAMetric ;
    rdfs:range apm:SLACategory ;
    rdfs:comment "An SLA metric is classified by the kind of service level it measures." .

apm:incurredByApplication a owl:ObjectProperty ;
    rdfs:label "incurred by application" ;
    rdfs:domain apm:CostRecord ;
    rdfs:range apm:Application ;
    rdfs:comment "A cost record names the application that incurred the cost." .

apm:hasCostCategory a owl:ObjectProperty ;
    rdfs:label "has cost category" ;
    rdfs:domain apm:CostRecord ;
    rdfs:range apm:CostCategory ;
    rdfs:comment "A cost record is classified by the type of cost it represents." .

apm:affectsApplication a owl:ObjectProperty ;
    rdfs:label "affects application" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:Application ;
    rdfs:comment "A finding is raised against an application." .

apm:affectsApplicationComponent a owl:ObjectProperty ;
    rdfs:label "affects application component" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:PhysicalApplicationComponent ;
    rdfs:comment "A finding is raised against a specific deployed instance of an application." .

apm:affectsTechnologyComponent a owl:ObjectProperty ;
    rdfs:label "affects technology component" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:PhysicalTechnologyComponent ;
    rdfs:comment "A finding is raised against a specific physical technology component." .

apm:hasFindingCategory a owl:ObjectProperty ;
    rdfs:label "has finding category" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:FindingCategory ;
    rdfs:comment "A finding is classified by its nature, such as Vulnerability, Technical Risk, Business Risk, or Control Gap." .

apm:hasFindingStatus a owl:ObjectProperty ;
    rdfs:label "has finding status" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:FindingStatus ;
    rdfs:comment "A finding is classified by its current position in the remediation lifecycle." .

apm:threatensCapability a owl:ObjectProperty ;
    rdfs:label "threatens capability" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:BusinessCapability ;
    rdfs:comment "A finding, typically one categorized as a Business Risk, threatens a specific business capability." .

apm:relatesToControl a owl:ObjectProperty ;
    rdfs:label "relates to control" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:Control ;
    rdfs:comment "A finding, typically one categorized as a Control Gap, identifies a deficiency in a specific control." .

apm:supportsComplianceStandard a owl:ObjectProperty ;
    rdfs:label "supports compliance standard" ;
    rdfs:domain apm:Control ;
    rdfs:range apm:ComplianceStandard ;
    rdfs:comment "A control satisfies or contributes to meeting a compliance standard." .

apm:implementsControl a owl:ObjectProperty ;
    rdfs:label "implements control" ;
    rdfs:domain apm:Application ;
    rdfs:range apm:Control ;
    rdfs:comment "An application has implemented a specific control." .

apm:hasImpactType a owl:ObjectProperty ;
    rdfs:label "has impact type" ;
    rdfs:domain apm:Finding ;
    rdfs:range apm:ImpactType ;
    rdfs:comment "A finding is classified by one or more types of consequence it could cause if left unaddressed." .


### --------------------------------------------------
### DATATYPE PROPERTIES
### --------------------------------------------------

apm:emailAddress a owl:DatatypeProperty ;
    rdfs:label "email address" ;
    rdfs:domain apm:Actor ;
    rdfs:range xsd:string ;
    rdfs:comment "The email address at which an actor can be contacted, such as for finding assignments or SLA breach notifications." .

apm:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number" ;
    rdfs:domain apm:Actor ;
    rdfs:range xsd:string ;
    rdfs:comment "The phone number at which an actor can be reached, such as for urgent SLA breach or overdue finding escalation." .

apm:goLiveDate a owl:DatatypeProperty ;
    rdfs:label "go-live date" ;
    rdfs:domain apm:Application ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the application first entered production use." .

apm:costCenterCode a owl:DatatypeProperty ;
    rdfs:label "cost center code" ;
    rdfs:domain apm:OrganizationUnit ;
    rdfs:range xsd:string ;
    rdfs:comment "The financial cost center code associated with an organization unit, used to attribute cost records." .

apm:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:domain apm:Location ;
    rdfs:range xsd:string ;
    rdfs:comment "The physical or postal address of a location." .

apm:retentionPeriod a owl:DatatypeProperty ;
    rdfs:label "retention period" ;
    rdfs:domain apm:DataEntity ;
    rdfs:range xsd:duration ;
    rdfs:comment "The maximum length of time a data entity may be retained before deletion or anonymisation, per applicable compliance obligations such as GDPR." .

apm:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:domain apm:LinkedResource ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The location at which a linked resource can be accessed." .

apm:lastUpdated a owl:DatatypeProperty ;
    rdfs:label "last updated" ;
    rdfs:domain apm:LinkedResource ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which a linked resource, such as a document or code repository, was last modified, used to flag potentially stale references." .

apm:costAmount a owl:DatatypeProperty ;
    rdfs:label "cost amount" ;
    rdfs:domain apm:CostRecord ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The monetary amount recorded for a cost record." .

apm:costCurrency a owl:DatatypeProperty ;
    rdfs:label "cost currency" ;
    rdfs:domain apm:CostRecord ;
    rdfs:range xsd:string ;
    rdfs:comment "The ISO 4217 currency code in which the cost amount is denominated, such as USD or EUR." .

apm:fiscalYear a owl:DatatypeProperty ;
    rdfs:label "fiscal year" ;
    rdfs:domain apm:CostRecord ;
    rdfs:range xsd:gYear ;
    rdfs:comment "The fiscal year in which the cost was incurred." .

apm:findingDetails a owl:DatatypeProperty ;
    rdfs:label "finding details" ;
    rdfs:domain apm:Finding ;
    rdfs:range xsd:string ;
    rdfs:comment "A description of the vulnerability, risk, or gap identified." .

apm:cveId a owl:DatatypeProperty ;
    rdfs:label "CVE ID" ;
    rdfs:domain apm:Finding ;
    rdfs:range xsd:string ;
    rdfs:comment "The Common Vulnerabilities and Exposures identifier associated with a Vulnerability finding, such as CVE-2021-44228." .

apm:cvssScore a owl:DatatypeProperty ;
    rdfs:label "CVSS score" ;
    rdfs:domain apm:Finding ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 10.0 ] )
    ] ;
    rdfs:comment "The raw CVSS base score for a Vulnerability finding, preserved at full precision alongside its bucketed riskScore." .

apm:identifiedOn a owl:DatatypeProperty ;
    rdfs:label "identified on" ;
    rdfs:domain apm:Finding ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the finding was identified." .

apm:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    rdfs:domain apm:Finding ;
    rdfs:range xsd:date ;
    rdfs:comment "The date by which the finding must be remediated under its applicable SLA." .

apm:resolvedDate a owl:DatatypeProperty ;
    rdfs:label "resolved date" ;
    rdfs:domain apm:Finding ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the finding reached a Remediated, Risk Accepted, or Closed status, enabling time-to-remediate reporting." .

apm:riskScore a owl:DatatypeProperty ; # [8][9]
    rdfs:label "risk score" ;
    rdfs:domain apm:Finding ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "The overall risk rating of the finding, informed by its likelihood and impact, on a scale of 1 (lowest) to 5 (highest)." .

apm:likelihoodScore a owl:DatatypeProperty ;
    rdfs:label "likelihood score" ;
    rdfs:domain apm:Finding ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "The probability that the finding's consequence will materialize if left unaddressed, on a scale of 1 (lowest) to 5 (highest)." .

apm:impactScore a owl:DatatypeProperty ;
    rdfs:label "impact score" ;
    rdfs:domain apm:Finding ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "The severity of consequence if the finding is left unaddressed, on a scale of 1 (lowest) to 5 (highest)." .

apm:capabilityWeight a owl:DatatypeProperty ;
    rdfs:label "capability weight" ;
    rdfs:domain apm:BusinessCapability ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "The relative strategic importance of the capability to the business, on a scale of 1 (lowest) to 5 (highest)." .

apm:capabilityLevel a owl:DatatypeProperty ;
    rdfs:label "capability level" ;
    rdfs:domain apm:BusinessCapability ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 3 ] )
    ] ;
    rdfs:comment "The depth of the capability within its hierarchical decomposition (e.g., L1, L2, L3), stored explicitly to avoid recomputing it by walking subCapabilityOf." .

apm:swidTagId a owl:DatatypeProperty ; # ISO-19770-2
    rdfs:label "SWID tag ID" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique tagId of the software product's ISO/IEC 19770-2 software identification (SWID) tag." .

apm:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range xsd:string ;
    rdfs:comment "The version identifier of the software product, as declared in its SWID tag." .

apm:endOfLifeDate a owl:DatatypeProperty ;
    rdfs:label "end of life date" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the vendor stops selling or developing the software product." .

apm:endOfSupportDate a owl:DatatypeProperty ;
    rdfs:label "end of support date" ;
    rdfs:domain apm:SoftwareProduct ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the vendor stops providing patches, security updates, or support for the software product." .

apm:entitledQuantity a owl:DatatypeProperty ; # ISO-19770-3
    rdfs:label "entitled quantity" ;
    rdfs:domain apm:SoftwareEntitlement ;
    rdfs:range xsd:integer ;
    rdfs:comment "The quantity of usage rights granted by the entitlement, interpreted according to its metric, enabling direct comparison against measured resource utilization." .

apm:measuredValue a owl:DatatypeProperty ; # ISO-19770-4
    rdfs:label "measured value" ;
    rdfs:domain apm:ResourceUtilizationRecord ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The quantity of actual consumption recorded, interpreted according to the record's metric." .

apm:measurementPeriodStart a owl:DatatypeProperty ; # ISO-19770-4
    rdfs:label "measurement period start" ;
    rdfs:domain apm:ResourceUtilizationRecord ;
    rdfs:range xsd:date ;
    rdfs:comment "The start of the period over which resource utilization was measured." .

apm:measurementPeriodEnd a owl:DatatypeProperty ; # ISO-19770-4
    rdfs:label "measurement period end" ;
    rdfs:domain apm:ResourceUtilizationRecord ;
    rdfs:range xsd:date ;
    rdfs:comment "The end of the period over which resource utilization was measured." .

apm:assetIdentifier a owl:DatatypeProperty ;
    rdfs:label "asset identifier" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( apm:PhysicalApplicationComponent apm:PhysicalTechnologyComponent )
    ] ;
    rdfs:range xsd:string ;
    rdfs:comment "A unique identifier for the physical asset or deployed instance, such as a hostname, IP address, serial number, or instance ID." .

# [6] International Organization for Standardization, "ISO 22301:2019 --
#     Security and resilience -- Business continuity management systems --
#     Requirements," ISO, Geneva, Switzerland, 2019. [Online]. Available:
#     https://www.iso.org/standard/75106.html

apm:recoveryTimeObjective a owl:DatatypeProperty ; # [6]
    rdfs:label "recovery time objective" ;
    rdfs:domain apm:Application ;
    rdfs:range xsd:duration ;
    rdfs:comment "The maximum acceptable duration within which an application must be restored following a disruption." .

apm:recoveryPointObjective a owl:DatatypeProperty ; # [6]
    rdfs:label "recovery point objective" ;
    rdfs:domain apm:Application ;
    rdfs:range xsd:duration ;
    rdfs:comment "The maximum acceptable amount of data loss, expressed as a duration, that can be tolerated following a disruption." .

apm:businessFitScore a owl:DatatypeProperty ;
    rdfs:label "business fit score" ;
    rdfs:domain apm:PerformanceAssessment ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "How well the application meets current and future business needs, on a scale of 1 (lowest) to 5 (highest)." .

apm:technicalFitScore a owl:DatatypeProperty ;
    rdfs:label "technical fit score" ;
    rdfs:domain apm:PerformanceAssessment ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] )
    ] ;
    rdfs:comment "How current, stable, and maintainable the application's technology is, on a scale of 1 (lowest) to 5 (highest)." .

apm:assessedOn a owl:DatatypeProperty ;
    rdfs:label "assessed on" ;
    rdfs:domain apm:PerformanceAssessment ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the performance assessment was conducted." .

apm:targetValue a owl:DatatypeProperty ;
    rdfs:label "target value" ;
    rdfs:domain apm:SLAMetric ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The numeric target committed to for an SLA metric, interpreted according to its unit of measure." .

apm:unitOfMeasure a owl:DatatypeProperty ;
    rdfs:label "unit of measure" ;
    rdfs:domain apm:SLAMetric ;
    rdfs:range xsd:string ;
    rdfs:comment "The unit in which an SLA metric's target value is expressed, such as %, requests/second, or milliseconds." .

apm:effectiveFrom a owl:DatatypeProperty ;
    rdfs:label "effective from" ;
    rdfs:domain apm:ServiceLevelAgreement ;
    rdfs:range xsd:date ;
    rdfs:comment "The date from which a service level agreement's terms take effect." .

apm:effectiveTo a owl:DatatypeProperty ;
    rdfs:label "effective to" ;
    rdfs:domain apm:ServiceLevelAgreement ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which a service level agreement's terms expire." .

apm:controlReference a owl:DatatypeProperty ; # [7]
    rdfs:label "control reference" ;
    rdfs:domain apm:Control ;
    rdfs:range xsd:string ;
    rdfs:comment "The clause or control identifier from an catalog that this control implements, such as ISO/IEC 27002 5.15 or NIST SP 800-53 AC-2." .

apm:lastReviewedDate a owl:DatatypeProperty ; # [7]
    rdfs:label "last reviewed date" ;
    rdfs:domain apm:Control ;
    rdfs:range xsd:date ;
    rdfs:comment "The date on which the control's design and operating effectiveness was last reviewed." .

### --------------------------------------------------
### INDIVIDUALS (Controlled Vocabulary)
### --------------------------------------------------

# Lifecycle Status

apm:Planned a apm:LifecycleStatus ;
    rdfs:label "Planned" ;
    rdfs:comment "The application is planned but not yet in development." .

apm:Development a apm:LifecycleStatus ;
    rdfs:label "Development" ;
    rdfs:comment "The application is being built and is not yet in production use." .

apm:Operate a apm:LifecycleStatus ;
    rdfs:label "Operate" ;
    rdfs:comment "The application is in production use." .

apm:Retired a apm:LifecycleStatus ;
    rdfs:label "Retired" ;
    rdfs:comment "The application has been decommissioned and is no longer in use." .


# Criticality Tier

apm:Critical a apm:CriticalityTier ;
    rdfs:label "Critical" ;
    rdfs:comment "An outage would cause severe disruption to the business." .

apm:High a apm:CriticalityTier ;
    rdfs:label "High" ;
    rdfs:comment "An outage would cause significant disruption to the business." .

apm:Medium a apm:CriticalityTier ;
    rdfs:label "Medium" ;
    rdfs:comment "An outage would cause moderate disruption to the business." .

apm:Low a apm:CriticalityTier ;
    rdfs:label "Low" ;
    rdfs:comment "An outage would cause minimal disruption to the business." .


# Investment Strategy (Gartner TIME) [4]

apm:Tolerate a apm:InvestmentStrategy ;
    rdfs:label "Tolerate" ;
    rdfs:comment "High technical fit but low business fit; kept running as-is since it is cheap to maintain." .

apm:Invest a apm:InvestmentStrategy ;
    rdfs:label "Invest" ;
    rdfs:comment "High technical fit and high business fit; funding is committed to grow or enhance the application." .

apm:Migrate a apm:InvestmentStrategy ;
    rdfs:label "Migrate" ;
    rdfs:comment "Low technical fit but high business fit; a valuable capability in need of a technical replacement." .

apm:Eliminate a apm:InvestmentStrategy ;
    rdfs:label "Eliminate" ;
    rdfs:comment "Low technical fit and low business fit; the application is a candidate for retirement." .


# Compliance Standard

apm:SOC2 a apm:ComplianceStandard ;
    rdfs:label "SOC 2" ;
    rdfs:comment "AICPA Service Organization Control 2, covering security, availability, and privacy of customer data." .

apm:HIPAA a apm:ComplianceStandard ;
    rdfs:label "HIPAA" ;
    rdfs:comment "U.S. Health Insurance Portability and Accountability Act, covering the protection of health information." .

apm:GDPR a apm:ComplianceStandard ;
    rdfs:label "GDPR" ;
    rdfs:comment "EU General Data Protection Regulation, covering the processing of personal data." .

apm:PCIDSS a apm:ComplianceStandard ;
    rdfs:label "PCI DSS" ;
    rdfs:comment "Payment Card Industry Data Security Standard, covering the handling of cardholder data." .

apm:ISO27001 a apm:ComplianceStandard ;
    rdfs:label "ISO/IEC 27001" ;
    rdfs:comment "International standard for information security management systems." .


# Hosting Model

apm:ExternallyHosted a apm:HostingModel ;
    rdfs:label "Externally Hosted" ;
    rdfs:comment "The application's infrastructure is hosted and operated by an external vendor, such as a SaaS or cloud provider." .

apm:InternallyHosted a apm:HostingModel ;
    rdfs:label "Internally Hosted" ;
    rdfs:comment "The application's infrastructure is hosted and operated within the organization's own environment." .

apm:Hybrid a apm:HostingModel ;
    rdfs:label "Hybrid" ;
    rdfs:comment "The application's infrastructure is split between externally hosted and internally hosted components." .


# Cost Category

apm:Licensing a apm:CostCategory ;
    rdfs:label "Licensing" ;
    rdfs:comment "Cost incurred from software licenses and entitlements." .

apm:Infrastructure a apm:CostCategory ;
    rdfs:label "Infrastructure" ;
    rdfs:comment "Cost incurred from hosting and technology infrastructure." .

apm:Support a apm:CostCategory ;
    rdfs:label "Support" ;
    rdfs:comment "Cost incurred from vendor or internal support and maintenance." .

apm:Labor a apm:CostCategory ;
    rdfs:label "Labor" ;
    rdfs:comment "Cost incurred from personnel who build, operate, or support the application." .


# Finding Category

apm:Vulnerability a apm:FindingCategory ;
    rdfs:label "Vulnerability" ;
    rdfs:comment "A security weakness that could be exploited, such as a CVE or misconfiguration." .

apm:TechnicalRisk a apm:FindingCategory ;
    rdfs:label "Technical Risk" ;
    rdfs:comment "A condition that threatens the stability, supportability, or continuity of the technology." .

apm:BusinessRisk a apm:FindingCategory ;
    rdfs:label "Business Risk" ;
    rdfs:comment "A condition that threatens the delivery of a business capability." .

apm:ControlGap a apm:FindingCategory ;
    rdfs:label "Control Gap" ;
    rdfs:comment "A missing or deficient control against an architectural, operational, or compliance requirement." .


# Finding Status

apm:Open a apm:FindingStatus ;
    rdfs:label "Open" ;
    rdfs:comment "The finding has been identified and remediation has not yet started." .

apm:InRemediation a apm:FindingStatus ;
    rdfs:label "In Remediation" ;
    rdfs:comment "Remediation of the finding is actively underway." .

apm:Remediated a apm:FindingStatus ;
    rdfs:label "Remediated" ;
    rdfs:comment "The underlying issue has been fixed and verified." .

apm:RiskAccepted a apm:FindingStatus ;
    rdfs:label "Risk Accepted" ;
    rdfs:comment "The finding will not be remediated; the associated risk has been formally accepted." .

apm:Closed a apm:FindingStatus ;
    rdfs:label "Closed" ;
    rdfs:comment "The finding requires no further action, whether through remediation or accepted risk." .


# Impact Type

apm:DataBreach a apm:ImpactType ;
    rdfs:label "Data Breach" ;
    rdfs:comment "Unauthorized access to or disclosure of sensitive data." .

apm:ServiceOutage a apm:ImpactType ;
    rdfs:label "Service Outage" ;
    rdfs:comment "Disruption or unavailability of the application or its dependent services." .

apm:RegulatoryFine a apm:ImpactType ;
    rdfs:label "Regulatory Fine" ;
    rdfs:comment "A financial penalty imposed for failing to meet a legal or compliance obligation." .

apm:ReputationalDamage a apm:ImpactType ;
    rdfs:label "Reputational Damage" ;
    rdfs:comment "Loss of trust or standing with customers, partners, or the public." .

apm:FinancialLoss a apm:ImpactType ;
    rdfs:label "Financial Loss" ;
    rdfs:comment "Direct monetary loss not attributable to a regulatory fine." .

apm:SafetyRisk a apm:ImpactType ;
    rdfs:label "Safety Risk" ;
    rdfs:comment "Potential for physical harm to people or damage to physical assets." .

apm:ContractualBreach a apm:ImpactType ;
    rdfs:label "Contractual Breach" ;
    rdfs:comment "Failure to meet an obligation owed to a customer, partner, or supplier under contract." .


# Data Sensitivity

apm:Public a apm:DataSensitivity ;
    rdfs:label "Public" ;
    rdfs:comment "Data intended for unrestricted public disclosure." .

apm:Internal a apm:DataSensitivity ;
    rdfs:label "Internal" ;
    rdfs:comment "Data intended for use within the organization, not for public disclosure." .

apm:Confidential a apm:DataSensitivity ;
    rdfs:label "Confidential" ;
    rdfs:comment "Sensitive business data whose disclosure could cause competitive or financial harm." .

apm:HighlyConfidential a apm:DataSensitivity ;
    rdfs:label "Highly Confidential" ;
    rdfs:comment "Extremely sensitive business data whose disclosure could cause severe competitive, financial, or reputational harm, such as trade secrets." .

apm:PII a apm:DataSensitivity ;
    rdfs:label "PII" ;
    rdfs:comment "Personally identifiable information that can be used to identify a specific individual." .

apm:PHI a apm:DataSensitivity ;
    rdfs:label "PHI" ;
    rdfs:comment "Protected health information relating to an individual's health status or care, as defined under HIPAA." .


# SLA Category

apm:Availability a apm:SLACategory ;
    rdfs:label "Availability" ;
    rdfs:comment "The proportion of time an application is operational and accessible, typically expressed as a percentage." .

apm:Throughput a apm:SLACategory ;
    rdfs:label "Throughput" ;
    rdfs:comment "The volume of work an application can process in a given period, such as requests or transactions per second." .

apm:ResponseTime a apm:SLACategory ;
    rdfs:label "Response Time" ;
    rdfs:comment "The time taken for an application to respond to a request." .

apm:ResolutionTime a apm:SLACategory ;
    rdfs:label "Resolution Time" ;
    rdfs:comment "The time taken to resolve a reported incident affecting an application." .


# Environment

apm:Production a apm:Environment ;
    rdfs:label "Production" ;
    rdfs:comment "The live environment serving actual business operations and end users." .

apm:Staging a apm:Environment ;
    rdfs:label "Staging" ;
    rdfs:comment "A pre-production environment used to validate changes under production-like conditions." .

apm:DevelopmentEnvironment a apm:Environment ;
    rdfs:label "Development" ;
    rdfs:comment "An environment used for active software development and unit testing." .

apm:Test a apm:Environment ;
    rdfs:label "Test" ;
    rdfs:comment "An environment used for formal testing activities, such as QA or user acceptance testing." .

apm:DisasterRecovery a apm:Environment ;
    rdfs:label "Disaster Recovery" ;
    rdfs:comment "A standby environment maintained to restore production operations following a disruption." .


# Dependency Protocol

apm:RESTAPI a apm:DependencyProtocol ;
    rdfs:label "REST API" ;
    rdfs:comment "Interaction over a RESTful HTTP API." .

apm:SOAP a apm:DependencyProtocol ;
    rdfs:label "SOAP" ;
    rdfs:comment "Interaction over the SOAP messaging protocol." .

apm:MessageQueue a apm:DependencyProtocol ;
    rdfs:label "Message Queue" ;
    rdfs:comment "Interaction via an asynchronous message broker or queue." .

apm:FileTransfer a apm:DependencyProtocol ;
    rdfs:label "File Transfer" ;
    rdfs:comment "Interaction via the exchange of files, such as SFTP or batch file drops." .

apm:DatabaseConnection a apm:DependencyProtocol ;
    rdfs:label "Database Connection" ;
    rdfs:comment "Interaction via a direct database connection, such as JDBC or ODBC." .

apm:RPC a apm:DependencyProtocol ;
    rdfs:label "RPC" ;
    rdfs:comment "Interaction via a remote procedure call framework, such as gRPC." .


# Synchronicity

apm:Synchronous a apm:Synchronicity ;
    rdfs:label "Synchronous" ;
    rdfs:comment "The calling asset blocks and waits for an immediate response, so an upstream failure propagates immediately." .

apm:Asynchronous a apm:Synchronicity ;
    rdfs:label "Asynchronous" ;
    rdfs:comment "The calling asset does not wait for an immediate response, so an upstream failure is buffered or delayed." .

apm:Batch a apm:Synchronicity ;
    rdfs:label "Batch" ;
    rdfs:comment "The interaction occurs on a scheduled cycle rather than on demand, so an upstream failure is only noticed at the next run." .


### --------------------------------------------------
### INDIVIDUAL DISTINCTNESS AXIOMS
### --------------------------------------------------
# To treat individuals as distinct, OWL requires explicit axioms. 
# Applyting the owl:AllDifferent to the controlled vocabulary of individuals to avoid unintended inferences.

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Planned apm:Development apm:Operate apm:Retired ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Critical apm:High apm:Medium apm:Low ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Tolerate apm:Invest apm:Migrate apm:Eliminate ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:SOC2 apm:HIPAA apm:GDPR apm:PCIDSS apm:ISO27001 ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:ExternallyHosted apm:InternallyHosted apm:Hybrid ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Licensing apm:Infrastructure apm:Support apm:Labor ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Vulnerability apm:TechnicalRisk apm:BusinessRisk apm:ControlGap ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Open apm:InRemediation apm:Remediated apm:RiskAccepted apm:Closed ) .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        apm:DataBreach apm:ServiceOutage apm:RegulatoryFine apm:ReputationalDamage
        apm:FinancialLoss apm:SafetyRisk apm:ContractualBreach
    ) .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        apm:Public apm:Internal apm:Confidential apm:HighlyConfidential apm:PII apm:PHI
    ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Availability apm:Throughput apm:ResponseTime apm:ResolutionTime ) .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        apm:Production apm:Staging apm:DevelopmentEnvironment apm:Test apm:DisasterRecovery
    ) .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        apm:RESTAPI apm:SOAP apm:MessageQueue apm:FileTransfer apm:DatabaseConnection apm:RPC
    ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( apm:Synchronous apm:Asynchronous apm:Batch ) .