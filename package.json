{
  "name": "nexus",
  "version": "1.0.0",
  "description": "An intelligent application portfolio hub",
  "keywords": [
    "nexus",
    "insight",
    "apm",
    "mcp"
  ],
  "homepage": "https://github.com/global/nexus#readme",
  "bugs": {
    "url": "https://github.com/global/nexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global/nexus.git"
  },
  "license": "MIT",
  "author": "Anderson Goulart <global@kokre.io>",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "env:dev": "cross-env NODE_ENV=dev nodemon server.js",
    "env:test": "cross-env NODE_ENV=test nodemon server.js",
    "env:prod": "cross-env NODE_ENV=prod node server.js",
    "mongo": "docker run -d --name mongo -p 27017:27017 mongo:7",
    "keycloak": "docker compose -f keycloak/docker-compose.yml up -d",
    "validate:ontology": "node ontology/validate-ttl.js",
    "validate:competency-queries": "node ontology/validate-competency-queries.js",
    "test": "cross-env NODE_ENV=dev jest --testTimeout=10000 --runInBand --silent --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "body-parser": "^2.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "joi": "^18.1.2",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "mongoose": "^9.5.0",
    "nodemon": "^3.1.14",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@comunica/query-sparql": "^5.3.0",
    "jest": "^30.3.0",
    "n3": "^2.1.2",
    "supertest": "^7.2.2"
  }
}
